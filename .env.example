# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交。
# MiniMax 国内站 OpenAI 兼容地址（2026-09 官方文档）
LLM_BASE_URL=https://api.minimax.cn/v1
LLM_API_KEY=your-key-here
LLM_MODEL=MiniMax-M3
# 单次运行最多调用几次工具，防止失控和浪费额度
LLM_MAX_TOOL_CALLS=15
# 可选：采样温度，越低越稳定；不填使用模型默认值
# LLM_TEMPERATURE=0.2
# 可选：单次请求超时秒数
# LLM_TIMEOUT_SECONDS=120

# 可选：下载 SEC 财报数据（da-agent fetch-financials）时必填。SEC 要求请求头写明联系方式
# SEC_USER_AGENT=da-agent 你的名字 you@example.com
