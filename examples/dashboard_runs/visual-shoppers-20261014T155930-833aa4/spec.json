{
  "title": "网站访问购买转化复盘",
  "goal": "给电商运营负责人：看整体购买转化水平，判断新老访客、流量来源、月份和商品页浏览深度中哪些转化更高，并看清小样本与代码口径的局限。",
  "metrics": [
    {
      "id": "visits",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "orders",
      "label": "购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "orders",
      "right": "visits",
      "format": "percent"
    },
    {
      "id": "exit_avg",
      "label": "平均退出率",
      "agg": "avg",
      "column": "ExitRates",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "visitor_scatter",
      "title": "访客类型：访问规模与转化率",
      "type": "scatter",
      "metrics": [
        "visits",
        "conv_rate"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "reference": "overall",
      "highlight": [
        "New_Visitor",
        "Returning_Visitor"
      ],
      "section": "访客类型",
      "why": "看新老访客各自带来多少访问、转化率谁高于整体",
      "insight": "新访客转化率 24.9%，高于整体 15.5%；老访客 13.9% 低于整体，但访问量 10,551 条，新访客仅 1,694 条"
    },
    {
      "id": "traffic_scatter",
      "title": "流量来源：规模与转化率（前 10）",
      "type": "scatter",
      "metrics": [
        "visits",
        "conv_rate"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源代码"
      },
      "reference": "overall",
      "highlight": [
        "8",
        "13"
      ],
      "section": "流量来源",
      "why": "找出量大但转化低的来源，优先处理",
      "insight": "访问量前 10 的来源中，代码 8 转化率最高 27.7%，代码 13 最低 5.8%；访问量最大的代码 2（3,913 条）21.7% 高于整体，代码 1（10.7%）和代码 3（8.8%）低于整体"
    },
    {
      "id": "traffic_bar",
      "title": "各流量来源购买转化率排名",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源代码"
      },
      "top_n": 15,
      "reference": "overall",
      "highlight": [
        "2",
        "8"
      ],
      "section": "流量来源",
      "why": "直接给出流量来源转化率的名次",
      "insight": "代码 2 为 21.7%（847 / 3,913），高于整体 15.5%；排在更前的代码 16（1 / 3）、7（12 / 40）样本量很小"
    },
    {
      "id": "month_conv",
      "title": "各月购买转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "reference": "overall",
      "highlight": [
        "Nov",
        "Feb"
      ],
      "section": "月份",
      "why": "看一年中哪些月份转化更高",
      "insight": "11 月最高 25.4%（760 / 2,998），高于整体 15.5%；2 月最低 1.6%，但只有 3 / 184 条记录，属小样本；12 月 12.5%（216 / 1,727）低于整体"
    },
    {
      "id": "pages_dist",
      "title": "商品页浏览数分布",
      "type": "column",
      "metrics": [
        "visits"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          6.0,
          21.0,
          51.0
        ],
        "label": "商品页浏览数"
      },
      "highlight": [
        "6–20"
      ],
      "width": "half",
      "section": "访问深度",
      "why": "看访问记录落在哪些浏览深度分段",
      "insight": "浏览 6–20 个商品页的记录最多 4,364 条（35.4%），1–5 个 2,331 条（18.9%）；0 页只有 38 条（0.3%）"
    },
    {
      "id": "pages_conv",
      "title": "商品页浏览数分段的转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          6.0,
          21.0,
          51.0
        ],
        "label": "商品页浏览数"
      },
      "reference": "overall",
      "highlight": [
        "≥51",
        "1–5"
      ],
      "width": "half",
      "section": "访问深度",
      "why": "看浏览商品页越多转化率是否越高",
      "insight": "从 1–5 段起转化率依次为 4.1%、13.2%、19.9%、25.3%，51 页以上最高 25.3%（544 / 2,152）高于整体 15.5%"
    },
    {
      "id": "kpi_visits",
      "title": "访问记录数",
      "type": "kpi",
      "metrics": [
        "visits"
      ],
      "why": "说明本次复盘的样本规模，所有比率都基于这批记录",
      "insight": "复盘样本共 12,330 条访问记录"
    },
    {
      "id": "kpi_orders",
      "title": "购买记录数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "说明有多少条访问记录最终带来购买",
      "insight": "其中 1,908 条记录标记为已购买"
    },
    {
      "id": "kpi_conv",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "回答整体转化水平如何，后续各分组都与它比较",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330）"
    },
    {
      "id": "kpi_exit",
      "title": "平均页面退出率",
      "type": "kpi",
      "metrics": [
        "exit_avg"
      ],
      "why": "给出访问质量的背景数",
      "insight": "全部记录的平均页面退出率为 4.3%"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "label": "访客类型"
    },
    {
      "column": "Weekend",
      "label": "是否周末"
    }
  ],
  "notes": [
    "没有数据说明且没有能唯一标识一行的列，因此所有按行统计的指标一律叫“记录数”，不判断一行是一个访客还是一次访问；有 125 行与其他行完全重复，会轻微抬高记录数与购买数",
    "Month 是文本月份，没有年份字段，只出现 Feb–Dec（缺 Jan、Apr），不能当作连续时间序列做环比",
    "小样本需当心：2 月仅 184 条记录、3 条购买；商品页浏览数为 0 的分段只有 38 条记录；转化率排名靠前的流量来源代码 16 仅 3 条、代码 7 仅 40 条",
    "TrafficType、Region、OperatingSystems、Browser 都是数字代码，文件没有名称对照，只能按代码横向比较",
    "流量来源条形图只显示转化率最高的 15 个来源，其余 5 个合并为“其他”，其中包含访问量 738 条、转化率 5.8% 的代码 13，低转化来源的完整情况请看散点图（按访问量取前 10）",
    "购买记录数口径为 Revenue = TRUE 的记录数；数据中没有订单金额、订单号等字段，无法计算客单价或 GMV，也无法识别重复访客"
  ]
}
