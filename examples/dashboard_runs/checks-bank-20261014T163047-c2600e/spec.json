{
  "title": "电话营销转化复盘看板",
  "goal": "给营销负责人复盘这轮电话营销：判断整体转化水平，找出转化更高的客群（年龄、学历）、更好的联系渠道与时机，以及哪些名单来源值得优先跟进。",
  "metrics": [
    {
      "id": "records",
      "label": "营销记录数",
      "agg": "count"
    },
    {
      "id": "subs",
      "label": "转化数",
      "agg": "count",
      "where": {
        "y": [
          "yes"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "转化率",
      "agg": "ratio",
      "left": "subs",
      "right": "records",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_records",
      "title": "营销记录数",
      "type": "kpi",
      "metrics": [
        "records"
      ],
      "why": "这轮营销覆盖了多少条联系记录，作为所有比率的分母",
      "insight": "这轮共 41,188 条营销记录。"
    },
    {
      "id": "kpi_conv",
      "title": "整体转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "整体转化水平如何，作为各分组对比的基线",
      "insight": "整体转化率 11.3%（4,640 / 41,188）。"
    },
    {
      "id": "dur_dist",
      "title": "通话时长分布",
      "type": "column",
      "metrics": [
        "records"
      ],
      "x": {
        "column": "duration",
        "bins": [
          120.0,
          300.0,
          600.0,
          1800.0
        ],
        "label": "通话时长(秒)"
      },
      "width": "half",
      "section": "整体",
      "why": "这轮通话大多停在哪个时长段，转化率图要结合样本量看",
      "insight": "记录集中在 120–299 秒（17,143 条，41.6%）和 ≤119 秒（12,795 条，31.1%）；≥1800 秒只有 101 条（0.3%）。"
    },
    {
      "id": "conv_by_dur",
      "title": "各通话时长段转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "duration",
        "bins": [
          120.0,
          300.0,
          600.0,
          1800.0
        ],
        "label": "通话时长(秒)"
      },
      "reference": "overall",
      "highlight": [
        "≤119",
        "600–1799"
      ],
      "width": "half",
      "section": "整体",
      "why": "哪些通话时长段的记录更可能转化",
      "insight": "转化率随时长段递增：≤119 秒 1.3%（164 / 12,795），600–1799 秒 48.3%（1,630 / 3,377），≥1800 秒 59.4%（60 / 101，样本仅 101 条），整体 11.3%。"
    },
    {
      "id": "conv_by_age",
      "title": "各年龄段转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "age",
        "bins": [
          18.0,
          25.0,
          35.0,
          50.0,
          65.0
        ],
        "label": "年龄"
      },
      "reference": "overall",
      "highlight": [
        "35–49",
        "≥65"
      ],
      "section": "客群",
      "why": "哪些年龄段客群转化更高",
      "insight": "记录数较多的年龄段里，≥65 岁 47.2%（313 / 663）最高，18–24 岁 23.9%（254 / 1,063）次之，35–49 岁 8.4%（1,549 / 18,379）最低，整体 11.3%。"
    },
    {
      "id": "conv_by_edu",
      "title": "各学历转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "education",
        "order": [
          "illiterate",
          "basic.4y",
          "basic.6y",
          "basic.9y",
          "high.school",
          "professional.course",
          "university.degree",
          "unknown"
        ],
        "label": "学历"
      },
      "reference": "overall",
      "highlight": [
        "university.degree",
        "basic.9y"
      ],
      "section": "客群",
      "why": "学历是否是区分转化高低的有效客群维度",
      "insight": "学历组之间差距不大：university.degree 13.7%（1,670 / 12,168）、professional.course 11.4%（595 / 5,243）、basic.9y 7.8%（473 / 6,045），都贴近整体 11.3%；illiterate（4 / 18）样本太小。"
    },
    {
      "id": "conv_by_month",
      "title": "各联系月份转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "month",
        "order": [
          "mar",
          "apr",
          "may",
          "jun",
          "jul",
          "aug",
          "sep",
          "oct",
          "nov",
          "dec"
        ],
        "label": "联系月份"
      },
      "reference": "overall",
      "highlight": [
        "mar",
        "may"
      ],
      "section": "渠道与时机",
      "why": "一年中哪些月份打出去效果更好",
      "insight": "3 月 50.6%（276 / 546）、12 月 48.9%（89 / 182）最高但样本很小；5 月 6.4%（886 / 13,769）最低，且记录数最多。"
    },
    {
      "id": "conv_by_contact",
      "title": "各联系渠道转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "contact",
        "label": "联系渠道"
      },
      "reference": "overall",
      "highlight": [
        "cellular",
        "telephone"
      ],
      "width": "half",
      "section": "渠道与时机",
      "why": "手机与座机哪个渠道转化更好",
      "insight": "cellular 14.7%（3,853 / 26,144）高于整体 11.3%，telephone 仅 5.2%（787 / 15,044）。"
    },
    {
      "id": "conv_by_poutcome",
      "title": "各上次营销结果转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "poutcome",
        "order": [
          "nonexistent",
          "failure",
          "success"
        ],
        "label": "上次营销结果"
      },
      "reference": "overall",
      "highlight": [
        "success",
        "nonexistent"
      ],
      "width": "half",
      "section": "渠道与时机",
      "why": "哪类名单来源转化更高",
      "insight": "上次转化成功过的名单本轮转化率 65.1%（894 / 1,373），上次失败 14.2%（605 / 4,252），从未联系过 8.8%（3,141 / 35,563），后者记录数最多。"
    }
  ],
  "filters": [
    {
      "column": "contact",
      "label": "联系渠道"
    },
    {
      "column": "month",
      "keep": [
        "may",
        "jul",
        "aug",
        "jun",
        "nov"
      ],
      "other_label": "其他月份",
      "order": [
        "mar",
        "apr",
        "may",
        "jun",
        "jul",
        "aug",
        "sep",
        "oct",
        "nov",
        "dec"
      ],
      "label": "联系月份"
    }
  ],
  "notes": [
    "一行是一条营销联系记录，没有任何列能唯一标识一行（还有 12 行完全重复），所以“营销记录数”是按行计数，不等于去重客户数，同一客户是否重复出现无法确认。",
    "month 只是联系发生的月份、没有年份，不是连续时间序列，各月样本量差异很大（5 月 13,769 条 vs 12 月 182 条），高转化率月份多为小样本。",
    "duration 是通话结束后的记录值，与转化率同向变化只说明两者相关，不能当作通话时长对转化的因果影响。",
    "像缺失值的取值：default 中 20.9%（8,597 行）是 unknown，education 中 4.2%（1,731 行）是 unknown，它们不是真实分组，不据此下结论。",
    "小样本注意：≥1800 秒 101 条、12 月 182 条、3 月 546 条、illiterate 学历 18 条，这些组的转化率波动大，不宜直接对比。",
    "poutcome=nonexistent（从未联系过）占 35,563 条记录、转化率 8.8%，它基本决定了整体 11.3% 的水平。"
  ]
}
