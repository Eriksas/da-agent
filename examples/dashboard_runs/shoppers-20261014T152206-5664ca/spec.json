{
  "title": "网站访问购买转化复盘看板",
  "goal": "给电商运营负责人复盘网站访问到购买的转化：先看整体转化水平，再对比访客类型、流量来源编码和月份的转化差异，并明确数据口径与样本量上的局限。",
  "metrics": [
    {
      "id": "sessions",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "buy_sessions",
      "label": "购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "buy_sessions",
      "right": "sessions",
      "format": "percent"
    },
    {
      "id": "avg_prod_pages",
      "label": "人均商品页数",
      "agg": "avg",
      "column": "ProductRelated"
    }
  ],
  "charts": [
    {
      "id": "kpi_conv",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "给出整体转化基准，作为各维度对比的参照",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330）。"
    },
    {
      "id": "kpi_sessions",
      "title": "访问记录数",
      "type": "kpi",
      "metrics": [
        "sessions"
      ],
      "why": "给出转化率的分母规模，判断整体比例背后的样本量",
      "insight": "数据共 12,330 条访问记录，是转化率的分母。"
    },
    {
      "id": "kpi_buy",
      "title": "产生购买的记录数",
      "type": "kpi",
      "metrics": [
        "buy_sessions"
      ],
      "why": "看转化分子有多少绝对量，判断转化是否集中在少数记录上",
      "insight": "标记为 Revenue=TRUE 的记录共 1,908 条。"
    },
    {
      "id": "tbl_visitor",
      "title": "访客类型：规模、转化率与浏览深度",
      "type": "table",
      "metrics": [
        "sessions",
        "buy_sessions",
        "conv_rate",
        "avg_prod_pages"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "why": "对比新老访客的规模、转化率和浏览深度，判断哪类访客转化更好",
      "insight": "新访客转化率 24.91%（422 / 1,694），高于回访访客 13.93%（1,470 / 10,551）；但回访访客人均浏览 34.1 页，高于新访客的 18.1 页。"
    },
    {
      "id": "tbl_traffic",
      "title": "流量来源编码：规模与转化率对照",
      "type": "table",
      "metrics": [
        "sessions",
        "buy_sessions",
        "conv_rate",
        "avg_prod_pages"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源编码"
      },
      "why": "对比各流量来源编码的规模与转化率，同时显示样本量，避免把小样本高比率当成结论",
      "insight": "规模最大的编码 2 有 3,913 条记录、转化率 21.65%（847 / 3,913）；编码 13 有 738 条、转化率仅 5.83%（43 / 738）；编码 12、17 各只有 1 条记录，比率不可用。"
    },
    {
      "id": "col_month_conv",
      "title": "每月购买转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "why": "看各月转化率高低，定位转化强和弱的月份",
      "insight": "Nov 最高 25.35%（760 / 2,998），Oct 为 20.95%（115 / 549），Dec 回落到 12.51%（216 / 1,727），Feb 最低 1.63%（3 / 184）。"
    },
    {
      "id": "col_month_sessions",
      "title": "每月访问记录数",
      "type": "column",
      "metrics": [
        "sessions"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "why": "看每月流量规模，判断各月转化率的分母是否足够、是否可比",
      "insight": "May 记录最多 3,364 条（占 27.3%），Nov 为 2,998 条（24.3%），Feb 最少仅 184 条，各月样本量差异很大。"
    },
    {
      "id": "heat_month_visitor",
      "title": "月份 × 访客类型 购买转化率",
      "type": "heatmap",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "series": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "why": "看新老访客转化差异在各月是否一致，判断高转化月份由哪类访客拉动",
      "insight": "新访客转化率在多数月份高于回访访客，如 Nov 的 30.55%（128 / 419）对 24.60%（629 / 2,557）；Feb 新访客只有 1 条记录，属极小样本。"
    },
    {
      "id": "col_weekend_conv",
      "title": "工作日与周末的购买转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Weekend",
        "label": "是否周末"
      },
      "why": "看周末与工作日的转化差异，判断周末排期和活动是否有价值",
      "insight": "周末转化率 17.4%（499 / 2,868），高于工作日 14.89%（1,409 / 9,462）。"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "label": "访客类型"
    },
    {
      "column": "Weekend",
      "label": "是否周末"
    }
  ],
  "notes": [
    "一行按一条访问记录计数：没有任何列能唯一标识一行，且有 125 行与其他行完全重复，因此无法确认同一访客是否重复出现。",
    "Revenue 只有 TRUE/FALSE 两种文本，口径未说明；本看板把 Revenue=TRUE 的记录当作购买记录，不等同于订单或成交金额。",
    "Month 只有 Feb–Dec 共 10 个月，缺 1 月和 4 月，且没有年份字段，无法判断周期是否完整、也无法跨年比较。",
    "TrafficType、Browser、Region、OperatingSystems 都是整数编码且无数据字典，编码含义未知；编码 12、17 仅 1 条、16 仅 3 条，比率为极端小样本，不可用于决策。",
    "样本高度集中：回访访客 10,551 条记录，新访客仅 1,694 条；May 和 Nov 分别占 27.3% 和 24.3%，其余月份样本较小，跨月比较需谨慎。",
    "Feb 转化率 1.63% 仅有 3 笔购买（分母 184），属于小样本极值，不代表稳定表现。"
  ]
}
