{
  "title": "电话营销转化复盘看板",
  "goal": "给营销负责人复盘这轮电话营销：先看整体转化水平，再比较客群（职业/年龄/教育）与渠道（联系方式/通话深度）的转化差异，判断下一轮资源投向。",
  "metrics": [
    {
      "id": "records",
      "label": "联系记录数",
      "agg": "count"
    },
    {
      "id": "subscribed",
      "label": "转化记录数",
      "agg": "count",
      "where": {
        "y": [
          "yes"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "转化率",
      "agg": "ratio",
      "left": "subscribed",
      "right": "records",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_records",
      "title": "联系记录数",
      "type": "kpi",
      "metrics": [
        "records"
      ],
      "why": "先给出这轮外呼的规模，作为转化率的分母",
      "insight": "本轮共 41,188 条联系记录，是所有转化率的分母。"
    },
    {
      "id": "kpi_subscribed",
      "title": "转化记录数",
      "type": "kpi",
      "metrics": [
        "subscribed"
      ],
      "why": "给出实际拿到的转化量，判断效率高低",
      "insight": "4,640 条联系记录最终标记为已转化（y=yes）。"
    },
    {
      "id": "kpi_conv",
      "title": "整体转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "营销负责人最关心的一个数：这轮电话营销整体转化怎么样",
      "insight": "整体转化率 11.3%（4,640 / 41,188），即每 9 条联系记录约有 1 条转化。"
    },
    {
      "id": "month_rate",
      "title": "每月转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "month",
        "order": [
          "mar",
          "apr",
          "may",
          "jun",
          "jul",
          "aug",
          "sep",
          "oct",
          "nov",
          "dec"
        ],
        "label": "联系月份"
      },
      "reference": "overall",
      "highlight": [
        "mar",
        "sep"
      ],
      "width": "full",
      "section": "整体表现",
      "why": "看转化率在这轮活动周期内怎么变化，哪些月份值得复制",
      "insight": "转化率月份间差异大：mar 50.6%（276 / 546）最高，may 6.4%（886 / 13,769）最低，整体 11.3%；mar、sep、dec 分别只有 546、570、182 条记录。"
    },
    {
      "id": "job_rate",
      "title": "各职业客群转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "job",
        "label": "职业"
      },
      "reference": "overall",
      "highlight": [
        "student",
        "retired"
      ],
      "width": "half",
      "section": "客群转化",
      "why": "看哪些职业客群转化更高，为下一轮选客群提供依据",
      "insight": "student 31.4%（275 / 875）、retired 25.2%（434 / 1,720）明显高于整体 11.3%，是转化最高的两个职业客群。"
    },
    {
      "id": "age_rate",
      "title": "各年龄段转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "age",
        "bins": [
          30.0,
          40.0,
          50.0,
          60.0
        ],
        "label": "年龄段"
      },
      "reference": "overall",
      "highlight": [
        "≥60",
        "≤29"
      ],
      "width": "half",
      "section": "客群转化",
      "why": "看年龄段与转化的关系，判断下一轮优先联系哪些年龄层",
      "insight": "≥60 岁 39.6%（472 / 1,193）远高于整体 11.3%，≤29 岁 16.3%（922 / 5,669）次之，40–49 岁 7.9%（834 / 10,526）最低。"
    },
    {
      "id": "edu_rate",
      "title": "各教育程度转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "education",
        "order": [
          "illiterate",
          "basic.4y",
          "basic.6y",
          "basic.9y",
          "high.school",
          "professional.course",
          "university.degree",
          "unknown"
        ],
        "label": "教育程度"
      },
      "reference": "overall",
      "highlight": [
        "university.degree",
        "basic.9y"
      ],
      "width": "full",
      "section": "客群转化",
      "why": "补充客群画像：看教育程度与转化的关系",
      "insight": "university.degree 13.7%（1,670 / 12,168）最高、basic.9y 7.8%（473 / 6,045）最低；illiterate 的 22.2% 仅来自 18 条记录，样本过小。"
    },
    {
      "id": "duration_rate",
      "title": "通话时长分段转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "duration",
        "bins": [
          60.0,
          180.0,
          300.0,
          600.0
        ],
        "label": "通话时长（秒）"
      },
      "reference": "overall",
      "highlight": [
        "≥600"
      ],
      "width": "full",
      "section": "渠道与互动",
      "why": "看通话深度与转化的关系，判断通话时长是否是有效的筛选信号",
      "insight": "转化率随通话时长单调上升：≤59 秒 0.02%（1 / 4,181），≥600 秒 48.6%（1,690 / 3,478），整体 11.3%。duration 是通话结束后的记录值。"
    },
    {
      "id": "contact_rate",
      "title": "各联系方式转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "contact",
        "label": "联系方式"
      },
      "reference": "overall",
      "highlight": [
        "cellular"
      ],
      "width": "half",
      "section": "渠道与互动",
      "why": "比较手机与座机两种外呼渠道的转化差异",
      "insight": "cellular 14.7%（3,853 / 26,144）高于整体 11.3%，telephone 5.2%（787 / 15,044）明显低于整体。"
    },
    {
      "id": "poutcome_rate",
      "title": "按上次营销结果转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "poutcome",
        "label": "上次营销结果"
      },
      "reference": "overall",
      "highlight": [
        "success",
        "nonexistent"
      ],
      "width": "half",
      "section": "渠道与互动",
      "why": "区分老客复购与新客首次触达，看转化主要来自哪一类名单",
      "insight": "上次已成交（success）65.1%（894 / 1,373），无历史记录（nonexistent，35,563 条）仅 8.8%（3,141 / 35,563）。"
    }
  ],
  "filters": [
    {
      "column": "contact",
      "label": "联系方式"
    },
    {
      "column": "day_of_week",
      "order": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri"
      ],
      "label": "联系星期"
    }
  ],
  "notes": [
    "口径：全部按“记录数”统计。数据没有唯一标识列，也没有数据说明，无法确认一行等于一个客户；其中 12 行与其他行完全相同。",
    "month 没有年份，只表示联系月份；各月记录数极不均衡，may 有 13,769 条（33.4%），dec 只有 182 条，mar、sep 等高转化月份的比率建立在小样本上。",
    "数据没有日期戳，无法判断各月是否为完整周期，也不能排除月份跨年。",
    "poutcome=success 的 1,373 条是上次营销已成交的老客，65.1% 的转化率会抬高整体；评估新客能力应看 nonexistent 一组（35,563 条、8.8%）。",
    "duration 是通话结束后的记录时长，与转化率同步升高，属于事后变量，不能直接当作事前筛选名单的依据。",
    "default=yes 仅 3 条、education=illiterate 仅 18 条，这些分组比率不稳定；emp.var.rate 等 5 个宏观指标与月份绑定，未放入看板以免与月份效应混淆。"
  ]
}
