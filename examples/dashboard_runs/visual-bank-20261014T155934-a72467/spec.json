{
  "title": "电话营销转化复盘看板",
  "goal": "给营销负责人复盘这轮电话营销：整体转化水平如何、哪些客群和渠道转化更高、哪些数据口径需要注意。",
  "metrics": [
    {
      "id": "rec",
      "label": "通话记录数",
      "agg": "count"
    },
    {
      "id": "sub",
      "label": "认购记录数",
      "agg": "count",
      "where": {
        "y": [
          "yes"
        ]
      }
    },
    {
      "id": "sub_rate",
      "label": "认购率",
      "agg": "ratio",
      "left": "sub",
      "right": "rec",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_rec",
      "title": "通话记录数",
      "type": "kpi",
      "metrics": [
        "rec"
      ],
      "why": "这轮营销一共覆盖了多少通话记录，是所有转化率的分母",
      "insight": "全部记录 41,188 条，所有分组转化率的分母都是它。"
    },
    {
      "id": "kpi_sub",
      "title": "认购记录数",
      "type": "kpi",
      "metrics": [
        "sub"
      ],
      "why": "这轮营销实际拿到多少认购，绝对量要结合转化率一起看",
      "insight": "认购记录 4,640 条，是各客群和渠道转化率的分子。"
    },
    {
      "id": "kpi_rate",
      "title": "整体认购率",
      "type": "kpi",
      "metrics": [
        "sub_rate"
      ],
      "why": "整体转化水平，作为各渠道、客群转化率的对比基准",
      "insight": "整体认购率 11.3%（4,640 / 41,188），图中虚线即此基准。"
    },
    {
      "id": "ch_contact",
      "title": "各联系方式的认购率",
      "type": "bar",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "contact",
        "label": "联系方式"
      },
      "reference": "overall",
      "highlight": [
        "cellular",
        "telephone"
      ],
      "width": "half",
      "section": "渠道",
      "why": "手机与固话两个渠道谁的转化更高，差多少",
      "insight": "cellular 14.7%（3,853 / 26,144），telephone 5.2%（787 / 15,044），整体 11.3%。"
    },
    {
      "id": "ch_poutcome",
      "title": "上次营销结果的认购率",
      "type": "bar",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "poutcome",
        "keep": [
          "success",
          "failure",
          "nonexistent"
        ],
        "label": "上次营销结果"
      },
      "reference": "overall",
      "highlight": [
        "success",
        "nonexistent"
      ],
      "width": "half",
      "section": "渠道",
      "why": "之前买过的人复购率有多高，值得优先回访哪批名单",
      "insight": "success 65.1%（894 / 1,373），failure 14.2%（605 / 4,252），nonexistent 8.8%（3,141 / 35,563），整体 11.3%。"
    },
    {
      "id": "ch_job",
      "title": "各职业客群的认购率",
      "type": "bar",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "job",
        "label": "职业"
      },
      "top_n": 12,
      "reference": "overall",
      "highlight": [
        "student",
        "retired",
        "blue-collar"
      ],
      "section": "客群",
      "why": "哪些职业客群转化明显高于或低于整体，名单要不要按职业分层",
      "insight": "student 最高 31.4%（275 / 875），retired 25.2%（434 / 1,720）；blue-collar 最低 6.9%（638 / 9,254），低于整体 11.3%。"
    },
    {
      "id": "ch_age",
      "title": "各年龄段认购率",
      "type": "column",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "age",
        "bins": [
          25.0,
          35.0,
          45.0,
          55.0,
          65.0
        ],
        "label": "年龄"
      },
      "reference": "overall",
      "highlight": [
        "≥65",
        "≤24",
        "35–44"
      ],
      "section": "客群",
      "why": "转化率是否随年龄变化，两端年龄的人是不是明显更好卖",
      "insight": "≥65 岁最高 47.2%（313 / 663），≤24 岁 24.0%（256 / 1,068），35–44 岁最低 8.7%（1,168 / 13,500），整体 11.3%。"
    },
    {
      "id": "ch_dur_vol",
      "title": "各通话时长段的记录数",
      "type": "column",
      "metrics": [
        "rec"
      ],
      "x": {
        "column": "duration",
        "bins": [
          60.0,
          180.0,
          300.0,
          600.0,
          1200.0
        ],
        "label": "通话时长(秒)"
      },
      "width": "half",
      "section": "通话过程",
      "why": "通话时长分布在哪里，量最大的时段是哪一段",
      "insight": "60–179 秒的记录最多，16,407 条、占 39.8%；≤59 秒 4,181 条（10.2%），≥1200 秒只有 515 条（1.3%）。"
    },
    {
      "id": "ch_dur_rate",
      "title": "各通话时长段的认购率",
      "type": "column",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "duration",
        "bins": [
          60.0,
          180.0,
          300.0,
          600.0,
          1200.0
        ],
        "label": "通话时长(秒)"
      },
      "reference": "overall",
      "highlight": [
        "≥1200",
        "60–179",
        "≤59"
      ],
      "width": "half",
      "section": "通话过程",
      "why": "通话越长认购率是否越高，占量最大的短通话是不是拉低了整体",
      "insight": "≤59 秒几乎没有认购：0.02%（1 / 4,181）；60–179 秒 3.4%（557 / 16,407）；≥1200 秒最高 62.3%（321 / 515），整体 11.3%。"
    },
    {
      "id": "ch_month",
      "title": "各月通话记录的认购率",
      "type": "column",
      "metrics": [
        "sub_rate"
      ],
      "x": {
        "column": "month",
        "order": [
          "mar",
          "apr",
          "may",
          "jun",
          "jul",
          "aug",
          "sep",
          "oct",
          "nov",
          "dec"
        ],
        "label": "月份"
      },
      "reference": "overall",
      "highlight": [
        "mar",
        "may"
      ],
      "section": "时间",
      "why": "不同月份的投放转化差多少，哪个时段的名单更值得投",
      "insight": "mar 最高 50.6%（276 / 546）、sep 44.9%（256 / 570）、dec 48.9%（89 / 182）样本都很小；量最大的 may 最低 6.4%（886 / 13,769），整体 11.3%。"
    }
  ],
  "filters": [
    {
      "column": "contact",
      "label": "联系方式"
    },
    {
      "column": "day_of_week",
      "order": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri"
      ],
      "label": "联系星期"
    }
  ],
  "notes": [
    "口径：认购率 = y=yes 的记录数 ÷ 全部记录数。数据没有说明，也没有任何列能唯一标识一行，一行只能当作一条通话联系记录（按记录数统计，不断言是一人一次）；有 12 行与其它行完全重复，未去重。",
    "month 只有月份、没有年份，各月数据来自不同年份，无法拼成连续时间轴，也不能当作同一轮投放的先后节奏；月度对比还要看样本量，dec 仅 182 条、sep 570 条、mar 546 条，个别小样本的高比率波动大。",
    "duration 是通话结束后才拿到的字段，只能说它与认购同时出现，不能据此认为通话时长带来认购；pdays=999 表示从未被联系过（占 96.3%），不能当作真实间隔天数。",
    "default、housing、loan、education、poutcome 等列含 unknown 取值（如 default=unknown 占 20.9%），这些记录归属不明，看板中未剔除。",
    "小样本分组要结合样本量看：student 875 条、≥65 岁 663 条；反过来 success 仅 1,373 条、占全部记录 3.3%，复购率高但覆盖人群有限。",
    "poutcome、previous、campaign 等字段反映的是此前营销接触历史，与本轮认购同现，不做因果解读。"
  ]
}
