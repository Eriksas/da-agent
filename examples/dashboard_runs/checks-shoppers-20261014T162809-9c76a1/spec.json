{
  "title": "网站访问购买转化复盘",
  "goal": "给电商运营负责人复盘网站访问的购买转化：先看整体转化水平，再判断访客类型、流量来源、月份和浏览深度上谁转化更高、量有多大，以及口径和数据局限。",
  "metrics": [
    {
      "id": "sessions",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "orders",
      "label": "购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "cvr",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "orders",
      "right": "sessions",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_sessions",
      "title": "访问记录数",
      "type": "kpi",
      "metrics": [
        "sessions"
      ],
      "why": "给出复盘期内的总访问规模，即转化率的分母口径",
      "insight": "复盘期内共 12,330 条访问记录。"
    },
    {
      "id": "kpi_orders",
      "title": "购买记录数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "给出标记为产生购买的记录数，即转化率的分子口径",
      "insight": "其中 1,908 条记录被标记为产生购买（Revenue = TRUE）。"
    },
    {
      "id": "kpi_cvr",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "cvr"
      ],
      "why": "回答“整体转化怎么样”这个最基本的问题",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330）。"
    },
    {
      "id": "bar_visitor",
      "title": "各访客类型购买转化率",
      "type": "bar",
      "metrics": [
        "cvr"
      ],
      "x": {
        "column": "VisitorType",
        "order": [
          "New_Visitor",
          "Returning_Visitor",
          "Other"
        ],
        "label": "访客类型"
      },
      "reference": "overall",
      "highlight": [
        "New_Visitor"
      ],
      "width": "half",
      "section": "访客与渠道",
      "why": "回答新客和老客谁更容易买，这是最直接可运营的分层",
      "insight": "新访客转化最高 24.9%（422 / 1,694），高于整体 15.5%；回访访客 13.9%（1,470 / 10,551）低于整体。Other 仅 85 条记录，样本过小。"
    },
    {
      "id": "scatter_traffic",
      "title": "各流量来源的规模与转化率",
      "type": "scatter",
      "metrics": [
        "sessions",
        "cvr"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源代码"
      },
      "top_n": 12,
      "reference": "overall",
      "highlight": [
        "2",
        "3"
      ],
      "width": "half",
      "section": "访客与渠道",
      "why": "回答哪些流量渠道量大但转化低，避免只看比率被小样本误导",
      "insight": "来源 2 规模最大（3,913 条）且转化 21.7%，高于整体 15.5%；来源 3 规模第二（2,052 条）转化仅 8.8%；来源 13 转化最低 5.8%，规模 738 条。图中只含访问量最大的 12 个来源，共 20 个。"
    },
    {
      "id": "col_month_sessions",
      "title": "各月份访问记录数",
      "type": "column",
      "metrics": [
        "sessions"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "width": "half",
      "section": "时间",
      "why": "回答各月流量规模有多大，判断月度转化对比是否建立在可比样本上",
      "insight": "5 月访问量最大 3,364 条（占 27.3%），11 月 2,998 条（24.3%），2 月仅 184 条，各月样本量差异很大。"
    },
    {
      "id": "col_month_cvr",
      "title": "各月份购买转化率",
      "type": "column",
      "metrics": [
        "cvr"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "reference": "overall",
      "highlight": [
        "Nov"
      ],
      "width": "half",
      "section": "时间",
      "why": "回答哪些月份转化更高，用于节奏与投放排期",
      "insight": "11 月转化最高 25.4%（760 / 2,998），高于整体 15.5%；2 月最低 1.6%（3 / 184）；12 月回落至 12.5%（216 / 1,727）。"
    },
    {
      "id": "col_pages_cvr",
      "title": "按浏览商品页数分段的转化率",
      "type": "column",
      "metrics": [
        "cvr"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          5.0,
          15.0,
          30.0
        ],
        "label": "浏览商品页数"
      },
      "reference": "overall",
      "highlight": [
        "≥30",
        "1–4"
      ],
      "width": "full",
      "section": "浏览深度",
      "why": "回答浏览更深的会话是否更容易购买，给详情页和内容优化提供依据",
      "insight": "浏览商品页 ≥30 的会话转化最高 23.0%（931 / 4,048），1–4 页最低 3.9%（76 / 1,949），整体 15.5%；0 页仅 38 条记录，样本过小。"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "order": [
        "New_Visitor",
        "Returning_Visitor",
        "Other"
      ],
      "label": "访客类型"
    },
    {
      "column": "Month",
      "keep": [
        "Nov",
        "May",
        "Dec",
        "Mar",
        "Oct",
        "Sep"
      ],
      "other_label": "其他月份",
      "order": [
        "Feb",
        "Mar",
        "May",
        "June",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
      ],
      "label": "月份"
    }
  ],
  "notes": [
    "无数据说明：无法确认一行代表一次会话还是一位访客，所有指标按记录数计算；表中有 125 行与其他行完全相同，记录数可能略有重复。",
    "Month 只有 10 个月份（无 1 月、4 月等），各月样本量差异很大（5 月 3,364 条 vs 2 月 184 条），且不是等长周期，跨月比较转化率需谨慎。",
    "TrafficType、Browser、OperatingSystems、Region 均为数字编码且无数据字典，只能按代码比较，不能解释成具体渠道、浏览器或地区。",
    "转化率口径：Revenue = TRUE 的记录数 ÷ 全部记录数。Revenue 是会话级标记，不是订单数；数据无金额字段，无法算客单价或收入。",
    "流量来源散点图只画了访问量最大的 12 个来源（共 20 个），小来源未展示；样本小的分组（如来源 20 的 198 条）比率波动大。",
    "访客类型中 Other 仅 85 条记录（16 次购买），2 月仅 3 次购买，这类小样本比率不宜单独下结论。"
  ]
}
