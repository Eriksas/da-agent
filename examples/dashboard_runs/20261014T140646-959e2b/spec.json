{
  "title": "销售经营看板（周例会）",
  "goal": "给运营负责人在周例会上看：整体销售规模与趋势、哪些市场和商品贡献最大，以及口径上必须注意的数据问题。",
  "metrics": [
    {
      "id": "gmv",
      "label": "销售GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "cancel_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消金额占比",
      "agg": "ratio",
      "left": "cancel_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "累计销售 GMV（£）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "例会开场先确认整体销售规模有多大",
      "insight": "全期累计销售 GMV 为 19,643,861.64 英镑（仅统计销售行）。"
    },
    {
      "id": "kpi_orders",
      "title": "累计订单数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "看成交笔数规模，判断增长来自单量还是单价",
      "insight": "期间共 39,516 笔销售订单（按发票号去重）。"
    },
    {
      "id": "kpi_aov",
      "title": "平均订单金额（£）",
      "type": "kpi",
      "metrics": [
        "aov"
      ],
      "why": "看单笔订单规模，判断是批发大单还是小额订单为主",
      "insight": "平均每单 497.11 英镑。"
    },
    {
      "id": "kpi_cancel",
      "title": "取消金额占销售比例",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "提醒运营 GMV 口径里含后续被取消的订单",
      "insight": "取消行金额相当于销售 GMV 的 3.65%，销售口径高于净成交。"
    },
    {
      "id": "month_gmv",
      "title": "每月销售 GMV（£）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "why": "看销售规模随时间怎么变、有没有季节性高峰和拐点",
      "insight": "2011-11 最高 £1,452,115.98，2011-02 最低 £507,799.87；2011-11 较 2011-10 涨 31.6%。"
    },
    {
      "id": "month_country",
      "title": "每月销售 GMV：英国 vs 海外",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "EIRE",
          "Netherlands"
        ],
        "other_label": "其他海外",
        "label": "市场"
      },
      "why": "看每月销售由哪些市场构成、海外是否在起量",
      "insight": "全程英国占 85.5%、其他海外 8.5%、EIRE 3.2%、Netherlands 2.8%；2011-11 英国为 1,280,862.64。"
    },
    {
      "id": "country_bar",
      "title": "各国销售 GMV 排名（£）",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "country",
        "label": "国家/地区"
      },
      "top_n": 8,
      "why": "看具体哪些市场贡献最大",
      "insight": "英国 16,801,019.39（85.5%）一家独大，之后是 EIRE 3.2%、Netherlands 2.8%，其余 35 个市场合计 3.1%。"
    },
    {
      "id": "product_bar",
      "title": "Top 10 商品销售 GMV（£）",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "description",
        "label": "商品名称"
      },
      "top_n": 10,
      "why": "看爆款是哪些商品、商品集中度如何",
      "insight": "Top1 REGENCY CAKESTAND 3 TIER 为 £330,590.32（1.7%），Top10 末尾 £71,300.40；其余 5,327 个商品合计占 92.2%。"
    },
    {
      "id": "week_hour",
      "title": "下单时段：星期 × 小时订单数",
      "type": "heatmap",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "weekday",
        "label": "星期"
      },
      "series": {
        "column": "invoice_time",
        "grain": "hour",
        "label": "小时"
      },
      "why": "看一周内下单集中在哪些时段，辅助运营排班",
      "insight": "最集中在周三 12 时（1,212 笔），周一至周五 10-15 时为下单密集段，周四 21 时为 0 笔。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Netherlands",
        "Germany",
        "France"
      ],
      "other_label": "其他海外",
      "label": "国家/地区"
    }
  ],
  "year_filter": true,
  "notes": [
    "口径：GMV = sum(amount) 且 line_type=销售；订单数 = 去重发票号；客单价 = GMV ÷ 订单数；金额单位为英镑。",
    "销售口径含之后被取消的订单：取消金额占 GMV 的 3.65%，图中 GMV 高于净成交。",
    "2011-12 只覆盖到 12-09（数据止于 2011-12-09 12:50），是不完整月份，不能与前面完整月份直接比较。",
    "市场高度集中：United Kingdom 占 85.5%，国家排名图里其他条形会被压扁，看海外请用堆叠图或国家筛选器。",
    "热力图每格是该时段内的去重订单数，一张订单可能跨多个时段，格子不能相加；图只显示有下单的时段。",
    "数据已去重并剔除坏账、单价 0 与运费等非商品行；customer_id 有 22.2% 缺失（游客/未登记），本看板未按客户统计。"
  ]
}
