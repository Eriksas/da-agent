{
  "title": "网站访问购买转化复盘",
  "goal": "给电商运营负责人复盘网站访问的购买转化：整体转化水平如何、哪些访客类型/流量来源/月份转化更高，以及口径和数据上的坑在哪里。",
  "metrics": [
    {
      "id": "visits",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "buyers",
      "label": "购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "buyers",
      "right": "visits",
      "format": "percent"
    },
    {
      "id": "avg_pages",
      "label": "平均浏览商品页数",
      "agg": "avg",
      "column": "ProductRelated"
    }
  ],
  "charts": [
    {
      "id": "kpi_visits",
      "title": "访问记录数",
      "type": "kpi",
      "metrics": [
        "visits"
      ],
      "why": "先给出整体口径下的访问量",
      "insight": "共 12,330 条访问记录，作为所有比率的分母。"
    },
    {
      "id": "kpi_buyers",
      "title": "购买记录数",
      "type": "kpi",
      "metrics": [
        "buyers"
      ],
      "why": "给出购买记录的绝对量",
      "insight": "Revenue 为 TRUE 的记录共 1,908 条。"
    },
    {
      "id": "kpi_conv",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "回答整体转化水平",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330）。"
    },
    {
      "id": "kpi_pages",
      "title": "平均浏览商品页数",
      "type": "kpi",
      "metrics": [
        "avg_pages"
      ],
      "why": "给出整体访问深度的基准值",
      "insight": "平均每条记录浏览 31.7 个商品页。"
    },
    {
      "id": "month_visits",
      "title": "各月访问记录数",
      "type": "column",
      "metrics": [
        "visits"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "width": "half",
      "section": "时间",
      "why": "看流量规模在月份上的分布，判断月份转化差异有多大基数",
      "insight": "5 月记录最多 3,364（占 27.3%），11 月 2,998（24.3%），2 月最少仅 184（1.5%）。"
    },
    {
      "id": "month_conv",
      "title": "各月购买转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "reference": "overall",
      "highlight": [
        "Nov",
        "Dec",
        "Feb"
      ],
      "width": "half",
      "section": "时间",
      "why": "看哪些月份转化高于整体水平",
      "insight": "11 月最高 25.4%（760 / 2,998），12 月回落到 12.5%（216 / 1,727）；2 月仅 1.6%（3 / 184），样本极小不宜横比。"
    },
    {
      "id": "visitor_conv",
      "title": "各访客类型购买转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "reference": "overall",
      "highlight": [
        "New_Visitor",
        "Returning_Visitor"
      ],
      "width": "full",
      "section": "客群",
      "why": "看新老访客哪一类转化更高",
      "insight": "新访客 24.9%（422 / 1,694）高于整体 15.5%，老访客 13.9%（1,470 / 10,551）最低；Other 为 18.8%（16 / 85），仅 85 条记录。"
    },
    {
      "id": "traffic_scatter",
      "title": "流量来源的规模与转化率",
      "type": "scatter",
      "metrics": [
        "visits",
        "conv_rate"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源编号"
      },
      "top_n": 12,
      "reference": "overall",
      "highlight": [
        "2",
        "13",
        "8"
      ],
      "width": "full",
      "section": "渠道",
      "why": "找流量大但转化低的来源，同时看规模与比率",
      "insight": "来源 2 规模最大 3,913 条、转化 21.7%；来源 13 有 738 条但转化仅 5.8%；来源 8 转化最高 27.7%（343 条）；整体 15.5%。"
    },
    {
      "id": "pages_dist",
      "title": "商品页浏览数分布",
      "type": "column",
      "metrics": [
        "visits"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          3.0,
          6.0,
          11.0,
          21.0,
          51.0
        ],
        "label": "浏览商品页数"
      },
      "width": "half",
      "section": "行为",
      "why": "看访问深度的人数分布，为下一张转化对比提供基数",
      "insight": "21–50 页最多 3,445（27.9%），≥51 页 2,152（17.5%），浏览 1–2 页 1,087（8.8%）。"
    },
    {
      "id": "pages_conv",
      "title": "各浏览深度的转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          3.0,
          6.0,
          11.0,
          21.0,
          51.0
        ],
        "label": "浏览商品页数"
      },
      "reference": "overall",
      "highlight": [
        "1–2",
        "≥51"
      ],
      "width": "half",
      "section": "行为",
      "why": "看浏览越深转化是否越高",
      "insight": "1–2 页最低 3.0%（33 / 1,087），此后逐段升至 ≥51 页的 25.3%（544 / 2,152）；0 页的 38 条为 15.8%，是例外。"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "label": "访客类型"
    },
    {
      "column": "TrafficType",
      "keep": [
        "2",
        "1",
        "3",
        "4",
        "13",
        "10"
      ],
      "other_label": "其他来源",
      "label": "流量来源编号"
    }
  ],
  "notes": [
    "没有数据说明且没有能唯一标识一行的列，125 行与其他行完全重复：一行只能当作一条访问记录，所有计数均为“记录数”，不等于去重访客数。",
    "Revenue=TRUE 记为购买（1,908 条）；数据里没有订单号、金额和日期时间，所以看不到 GMV、客单价，也做不了按日期的趋势，只能按月名对比。",
    "Month 只有 2–12 月共 10 个月且无年份：2 月仅 184 条（转化 1.6%，3 / 184），疑似不完整月份，小样本比率不要与其他月份横比。",
    "TrafficType / Region / Browser / OperatingSystems 都是编号，含义未知，只能按编号比较；流量来源散点只画了记录数最大的 12 个编号（共 20 个），长尾未展示。",
    "访客类型中老访客占 85.6%，Other 仅 85 条记录（转化 16 / 85），比率波动大，不宜作为结论依据。",
    "转化率=该分组内 Revenue=TRUE 记录数 ÷ 该分组记录数，是同一批记录上的关联对比，不代表因果，也不能推算成交规模。"
  ]
}
