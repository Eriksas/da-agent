{
  "title": "网站访问购买转化复盘看板",
  "goal": "给电商运营负责人复盘网站访问到购买的转化：整体水平如何、哪些访客类型/流量来源/月份转化更高，以及哪些数据口径和样本量问题需要提醒。",
  "metrics": [
    {
      "id": "visits",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "buyers",
      "label": "产生购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "conv_rate",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "buyers",
      "right": "visits",
      "format": "percent"
    },
    {
      "id": "avg_prod_pages",
      "label": "平均商品页浏览数",
      "agg": "avg",
      "column": "ProductRelated"
    }
  ],
  "charts": [
    {
      "id": "kpi_visits",
      "title": "总访问记录数",
      "type": "kpi",
      "metrics": [
        "visits"
      ],
      "why": "先界定这次复盘覆盖了多少条访问记录",
      "insight": "数据共 12,330 条访问记录，是本次复盘的全部样本。"
    },
    {
      "id": "kpi_conv",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "conv_rate"
      ],
      "why": "给出整体转化的基准线，后面各维度都和它比",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330）。"
    },
    {
      "id": "kpi_buyers",
      "title": "产生购买的记录数",
      "type": "kpi",
      "metrics": [
        "buyers"
      ],
      "why": "看转成购买的实际记录规模，避免只看比率",
      "insight": "被标记为产生购买的记录共 1,908 条。"
    },
    {
      "id": "kpi_pages",
      "title": "平均每条记录的商品页浏览数",
      "type": "kpi",
      "metrics": [
        "avg_prod_pages"
      ],
      "why": "给转化率配一个整体浏览深度参考值",
      "insight": "每条记录平均浏览 31.7 个商品相关页面。"
    },
    {
      "id": "bar_visitor",
      "title": "各访客类型购买转化率",
      "type": "bar",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "top_n": 5,
      "why": "回答新老访客谁的购买转化更高",
      "insight": "新访客转化最高 24.9%（422 / 1,694），回访客最低 13.9%（1,470 / 10,551）；Other 仅 16 / 85。"
    },
    {
      "id": "bar_visitor_pages",
      "title": "各访客类型平均商品页浏览数",
      "type": "bar",
      "metrics": [
        "avg_prod_pages"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "top_n": 5,
      "why": "看新老访客浏览深度差异，作为转化差异的配套观察",
      "insight": "回访客平均浏览 34.1 个商品页，新访客 18.1 个，Other 12.5 个。"
    },
    {
      "id": "table_traffic",
      "title": "主要流量来源转化与样本量",
      "type": "table",
      "metrics": [
        "visits",
        "buyers",
        "conv_rate"
      ],
      "x": {
        "column": "TrafficType",
        "keep": [
          "1",
          "2",
          "3",
          "4",
          "13"
        ],
        "other_label": "其他来源",
        "label": "流量来源代码"
      },
      "why": "回答哪些流量来源转化更高，并同时给出各来源记录量",
      "insight": "来源 2 体量最大 3,913 条、转化 21.7%（847 / 3,913），来源 13 转化最低 5.8%（43 / 738）；其余来源合并后为 19.5%（411 / 2,107）。"
    },
    {
      "id": "col_month_conv",
      "title": "各月份购买转化率",
      "type": "column",
      "metrics": [
        "conv_rate"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "why": "回答一年中哪些月份转化更高",
      "insight": "Nov 最高 25.4%（760 / 2,998），Dec 为 12.5%（216 / 1,727），Feb 最低 1.6%（3 / 184）；记录最多的 May（3,364）为 10.9%。"
    },
    {
      "id": "col_month_visits",
      "title": "各月份访问记录数",
      "type": "column",
      "metrics": [
        "visits"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "why": "看各月访问量，判断月度转化率背后有多少样本支撑",
      "insight": "记录集中在 May 3,364 条（27.3%）和 Nov 2,998 条（24.3%），Feb 仅 184 条（1.5%）。"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "label": "访客类型"
    },
    {
      "column": "TrafficType",
      "keep": [
        "1",
        "2",
        "3",
        "4",
        "13"
      ],
      "other_label": "其他来源",
      "label": "流量来源代码"
    }
  ],
  "notes": [
    "口径：所有按行计算的指标都是“记录数”。数据没有数据说明，也没有任何列能唯一标识一行，无法确认一行等于一个访客或一次会话，同一对象可能重复计入，转化率是记录口径而非去重访客口径。",
    "有 125 行与其他行完全重复（约占 1%），所有数字按原始记录统计、未去重。",
    "Month 只有月份没有年份（10 个标签，缺 Jan 和 Apr），不能做同比或连续趋势判断，只能比较各月份标签；Feb 仅 184 条记录，其 1.6% 转化率属小样本。",
    "May 与 Nov 合计占 51.6% 的记录，整体 15.5% 的转化率受这两个月影响较大。",
    "TrafficType、Region、OperatingSystems、Browser 都是整数代码且无名称对照表，看板只用代码数字展示、不做渠道名称解读；TrafficType 共 20 个取值，图中只单列记录最多的 5 个，其余合并为“其他来源”。",
    "回访客记录占 10,551 / 12,330（85.6%），与新访客（1,694 条）比较时要留意样本量差异；Revenue=TRUE 只表示该条记录被标记为产生收入，数据中没有金额、订单或客单价字段。"
  ]
}
