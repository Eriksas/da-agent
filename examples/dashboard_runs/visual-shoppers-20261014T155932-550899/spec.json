{
  "title": "网站访问购买转化复盘看板",
  "goal": "给电商运营负责人复盘网站访问的购买转化：先看整体转化水平，再看新老访客、地域、浏览深度、流量来源和月份谁的转化更高，并标明数据口径的局限。",
  "metrics": [
    {
      "id": "visits",
      "label": "访问记录数",
      "agg": "count"
    },
    {
      "id": "orders",
      "label": "购买记录数",
      "agg": "count",
      "where": {
        "Revenue": [
          "TRUE"
        ]
      }
    },
    {
      "id": "conv",
      "label": "购买转化率",
      "agg": "ratio",
      "left": "orders",
      "right": "visits",
      "format": "percent"
    },
    {
      "id": "exit_avg",
      "label": "平均退出率",
      "agg": "avg",
      "column": "ExitRates",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_visits",
      "title": "访问记录数",
      "type": "kpi",
      "metrics": [
        "visits"
      ],
      "why": "复盘期一共沉淀了多少条访问记录，作为所有转化比率的分母",
      "insight": "全量 12,330 条访问记录，是各转化率的分母。"
    },
    {
      "id": "kpi_orders",
      "title": "购买记录数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "产生购买的记录规模有多大，判断转化分子",
      "insight": "Revenue 为 TRUE 的记录 1,908 条。"
    },
    {
      "id": "kpi_conv",
      "title": "整体购买转化率",
      "type": "kpi",
      "metrics": [
        "conv"
      ],
      "why": "整体转化水平如何，作为各维度对比的基准",
      "insight": "整体购买转化率 15.5%（1,908 / 12,330），看板各图虚线即此值。"
    },
    {
      "id": "kpi_exit",
      "title": "平均退出率",
      "type": "kpi",
      "metrics": [
        "exit_avg"
      ],
      "why": "整体访问深度质量如何，配合转化率判断流量价值",
      "insight": "平均退出率 4.3%，是全站单条记录的平均水平。"
    },
    {
      "id": "bar_visitor",
      "title": "各访客类型的购买转化率",
      "type": "bar",
      "metrics": [
        "conv"
      ],
      "x": {
        "column": "VisitorType",
        "label": "访客类型"
      },
      "reference": "overall",
      "highlight": [
        "New_Visitor",
        "Returning_Visitor"
      ],
      "width": "half",
      "section": "访客与地域",
      "why": "新老访客的转化差多少，投放和会员运营该偏向谁",
      "insight": "新访客转化最高 24.9%（422 / 1,694），老访客最低 13.9%（1,470 / 10,551），虚线为整体水平。"
    },
    {
      "id": "col_depth",
      "title": "不同商品页浏览量的购买转化率",
      "type": "column",
      "metrics": [
        "conv"
      ],
      "x": {
        "column": "ProductRelated",
        "bins": [
          1.0,
          10.0,
          30.0,
          60.0
        ],
        "label": "商品页浏览量"
      },
      "reference": "overall",
      "highlight": [
        "≥60",
        "1–9"
      ],
      "width": "half",
      "section": "访客与地域",
      "why": "浏览商品页的多少与转化高低的关系，判断内容深度的价值",
      "insight": "浏览量 ≥60 段最高 26.2%（450 / 1,719），1–9 段最低 6.1%（231 / 3,805）；0 段仅 38 条记录、6 笔购买。"
    },
    {
      "id": "bar_region",
      "title": "各地区的购买转化率",
      "type": "bar",
      "metrics": [
        "conv"
      ],
      "x": {
        "column": "Region",
        "label": "地区编码"
      },
      "reference": "overall",
      "highlight": [
        "9",
        "8"
      ],
      "section": "访客与地域",
      "why": "地域投放的转化差异有多大，是否值得分区域运营",
      "insight": "地区 9 最高 16.8%（86 / 511），地区 8 最低 12.9%（56 / 434），全部 9 个地区都落在 12.9%–16.8% 的窄区间内。"
    },
    {
      "id": "scatter_traffic",
      "title": "各流量来源的规模与转化率",
      "type": "scatter",
      "metrics": [
        "visits",
        "conv"
      ],
      "x": {
        "column": "TrafficType",
        "label": "流量来源编码"
      },
      "top_n": 10,
      "reference": "overall",
      "highlight": [
        "2",
        "13",
        "8"
      ],
      "section": "流量来源",
      "why": "哪些来源量大但转化低、哪些量小却转化高，预算该往哪边加",
      "insight": "来源 8 转化最高 27.7%（343 条访问），来源 13 最低 5.8%（738 条）；来源 2 同时量大（3,913 条）且转化 21.7% 高于整体 15.5%，来源 1、3 量也大但转化仅 10.7%、8.8%。"
    },
    {
      "id": "col_month_conv",
      "title": "各月购买转化率",
      "type": "column",
      "metrics": [
        "conv"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "reference": "overall",
      "highlight": [
        "Nov",
        "Feb"
      ],
      "width": "half",
      "section": "月份节奏",
      "why": "哪些月份转化更高，大促节奏与日常流量怎么排",
      "insight": "Nov 最高 25.4%（760 / 2,998），Feb 最低 1.6%（3 / 184，仅 3 笔购买），整体 15.5%。"
    },
    {
      "id": "col_month_visits",
      "title": "各月访问记录数",
      "type": "column",
      "metrics": [
        "visits"
      ],
      "x": {
        "column": "Month",
        "order": [
          "Feb",
          "Mar",
          "May",
          "June",
          "Jul",
          "Aug",
          "Sep",
          "Oct",
          "Nov",
          "Dec"
        ],
        "label": "月份"
      },
      "highlight": [
        "May",
        "Nov"
      ],
      "width": "half",
      "section": "月份节奏",
      "why": "流量规模在月份之间怎么分布，转化高低要结合基数看",
      "insight": "May 记录最多 3,364 条（27.3%），Nov 2,998 条（24.3%），Feb 最少 184 条（1.5%）。"
    }
  ],
  "filters": [
    {
      "column": "VisitorType",
      "order": [
        "New_Visitor",
        "Returning_Visitor",
        "Other"
      ],
      "label": "访客类型"
    },
    {
      "column": "Weekend",
      "order": [
        "FALSE",
        "TRUE"
      ],
      "label": "是否周末"
    }
  ],
  "notes": [
    "没有能唯一标识一行的列，且有 125 行与其他行完全重复：按行计数的指标一律叫“访问记录数”，不是去重访客数，也不保证同一访客只出现一次。",
    "Month 是文本标签而非日期，只有 Feb–Dec 10 个月（缺 Jan、Apr），没有年份信息，不能当作连续时间序列看环比。Feb 仅 184 条记录、3 笔购买，其 1.6% 转化属小样本极值。",
    "流量来源、地区、浏览器、操作系统等维度只有数字编码、没有名称映射，只能按编码解读。来源散点只画了访问量最大的 10 个编码（共 20 个）。",
    "转化口径为 Revenue=TRUE 的记录占比；表中没有订单金额字段，因此无法看客单价或 GMV。",
    "Returning_Visitor 占 85.6% 的记录，Other 仅 85 条、其 18.8% 转化样本很小，解读时需注意基数。"
  ]
}
