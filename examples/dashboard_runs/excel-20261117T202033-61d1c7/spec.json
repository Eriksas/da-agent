{
  "title": "2011 年各国销售与取消情况看板",
  "goal": "给运营负责人：看清 2011 年各国销售的月度走势、哪些国家贡献最大、各国和每月的取消情况有多严重。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "GMV",
      "format": "money"
    },
    {
      "id": "cancel",
      "label": "取消金额",
      "agg": "sum",
      "column": "取消金额",
      "format": "money"
    },
    {
      "id": "net_gmv",
      "label": "净销售额",
      "agg": "difference",
      "left": "gmv",
      "right": "cancel",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "gmv_rest",
      "label": "GMV（不含英国）",
      "agg": "sum",
      "column": "GMV",
      "where": {
        "国家": [
          "France",
          "Germany",
          "Netherlands",
          "EIRE",
          "其他国家"
        ]
      },
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "2011 年 GMV 合计",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "全年销售规模有多大，作为整体基线",
      "insight": "2011 年 GMV 合计 9,471,580.96 英镑。"
    },
    {
      "id": "kpi_net",
      "title": "2011 年净销售额",
      "type": "kpi",
      "metrics": [
        "net_gmv"
      ],
      "why": "下单口径里有多少金额后来被取消，实际规模有多大",
      "insight": "扣掉取消金额后的净销售额 9,013,227.66 英镑（GMV 减取消金额）。"
    },
    {
      "id": "kpi_cancel",
      "title": "2011 年整体取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "整体取消情况有多严重，作为各国、各月取消率的对照",
      "insight": "全年整体取消率 4.84%（取消金额 458,353.30 / GMV 9,471,580.96）。"
    },
    {
      "id": "gmv_trend_total",
      "title": "每月 GMV 合计",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "月份",
        "grain": "month"
      },
      "width": "full",
      "section": "走势",
      "why": "2011 年整体月度销售走势如何，哪个月最高",
      "insight": "2011-11 最高 1,452,115.98，2011-02 最低 507,799.87；11 月比 10 月的 1,103,314.25 增长 31.6%。2011-12 只统计到 12-09，不能与完整月份比较。"
    },
    {
      "id": "gmv_mix_month",
      "title": "每月 GMV 构成（按国家）",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "月份",
        "grain": "month"
      },
      "series": {
        "column": "国家",
        "keep": [
          "United Kingdom",
          "其他国家"
        ],
        "other_label": "其余4国"
      },
      "width": "full",
      "section": "国家贡献",
      "why": "每个月由哪些国家贡献，英国之外的份额有多大",
      "insight": "英国每个月都是最大来源，全年占 84.7%；其余 4 国合计占 9.6%，“其他国家”占 5.8%；其中英国 2011-11 单月最高 1,280,862.64。12 月为部分月份。"
    },
    {
      "id": "gmv_rank",
      "title": "各国 GMV 排名",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "国家"
      },
      "top_n": 6,
      "width": "half",
      "section": "国家贡献",
      "why": "哪些国家贡献了最多销售额",
      "insight": "英国 8,019,210.82 英镑，占全年 84.7%；其次是“其他国家” 547,967.58，法国最低 175,962.69。"
    },
    {
      "id": "gmv_rank_rest",
      "title": "英国以外各国 GMV",
      "type": "bar",
      "metrics": [
        "gmv_rest"
      ],
      "x": {
        "column": "国家"
      },
      "top_n": 5,
      "width": "half",
      "section": "国家贡献",
      "why": "剔除英国后，其他市场各自贡献多少",
      "insight": "英国以外 5 个市场合计 1,452,370.14 英镑，其中“其他国家”最高 547,967.58，占这 5 个市场的 37.7%；荷兰 275,134.86 次之，法国最低 175,962.69。"
    },
    {
      "id": "cancel_rate_month",
      "title": "每月取消率",
      "type": "column",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "月份",
        "grain": "month"
      },
      "reference": "overall",
      "width": "half",
      "section": "取消情况",
      "why": "取消情况随月份怎么变化，哪些月份高于全年水平",
      "insight": "2011-12 取消率 28.33%（174,091.36 / 614,490.92）为全年最高，但 12 月只统计到 12-09；完整月份（1—11 月）中超过全年整体 4.84% 的只有 1 月 13.65%（91,525.05 / 670,380.24）和 4 月 6.46%，5 月最低 1.21%。"
    },
    {
      "id": "cancel_rate_country",
      "title": "各国取消率",
      "type": "bar",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "国家"
      },
      "reference": "overall",
      "width": "half",
      "section": "取消情况",
      "why": "哪个国家的取消情况最严重，各国与整体水平相比如何",
      "insight": "英国取消率最高 5.35%（428,750.21 / 8,019,210.82），高于全年整体 4.84%；荷兰最低 0.15%（409.80 / 275,134.86）。"
    }
  ],
  "filters": [
    {
      "column": "国家",
      "label": "国家"
    }
  ],
  "notes": [
    "数据截至 2011-12-09，12 月只有部分天数，12 月的金额与比率不能与完整月份比较。",
    "GMV 为下单口径，含之后被取消的订单；净销售额 = GMV − 取消金额。",
    "单位为英镑；“其他国家”是源表中的合并项，不代表单一国家。",
    "源表中的 13 行合计/小计已被剔除，不会重复计入。",
    "源表无数据说明，每行只能按“某国家某月的汇总记录”理解。"
  ]
}
