{
  "title": "月度 GMV、客单价与新老客结构",
  "goal": "给电商运营同学：看每月 GMV 与客单价走势，判断增长来自单量、单价还是客群结构，并识别异常与低谷月份（停业、大额取消、数据截止）。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "active_customers",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "buyer_id"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "sum",
      "column": "net_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "全期 GMV",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出整段区间的 GMV 总量，作为所有月度对比的基准",
      "insight": "2009-12 至 2011-12 全期 GMV 合计 19,643,861.64 英镑（下单口径，含之后被取消的订单）。"
    },
    {
      "id": "kpi_aov",
      "title": "全期客单价 AOV",
      "type": "kpi",
      "metrics": [
        "aov"
      ],
      "why": "给出整段区间的客单价水平，作为月度客单价的对照",
      "insight": "全期客单价 497.11 英镑（GMV 19,643,861.64 ÷ 订单 39,516）。"
    },
    {
      "id": "kpi_cancel",
      "title": "全期取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "提示下单口径的 GMV 中有多少金额后来被取消",
      "insight": "全期取消金额 716,462.57 英镑，占 GMV 的 3.65%（716,462.57 / 19,643,861.64）。"
    },
    {
      "id": "gmv_monthly",
      "title": "每月 GMV 走势",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "整体走势",
      "why": "看 GMV 的月度走势，找出峰值月与低谷月",
      "insight": "2011-11 最高 1,452,115.98，完整月份中最低是 2011-02 的 507,799.87；11 月连续两年是峰值（2010-11 为 1,429,700.78），2011-11 较 2011-10 的 1,103,314.25 增长 31.61%。2011-12 是不完整月份，不可直接比。"
    },
    {
      "id": "orders_monthly",
      "title": "每月订单数",
      "type": "line",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "half",
      "section": "整体走势",
      "why": "看下单量的月度变化，辅助判断 GMV 波动来自单量还是单价",
      "insight": "2011-11 最高 2,751 单，完整月份中最低是 2010-01 的 1,049 单；2010-12 只有 1,550 单，低于 2010-11 的 2,719 单（该月有停业日）。"
    },
    {
      "id": "customers_monthly",
      "title": "每月活跃客户数",
      "type": "line",
      "metrics": [
        "active_customers"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "half",
      "section": "整体走势",
      "why": "看每月有购买的可识别客户数，辅助判断 GMV 波动来自客户数还是人均下单",
      "insight": "2011-11 最高 1,660 个，完整月份中最低是 2011-01 的 739 个；2011-11 较 2011-10 的 1,361 个增加 22%。"
    },
    {
      "id": "aov_monthly",
      "title": "每月客单价 AOV",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "reference": "overall",
      "width": "full",
      "section": "整体走势",
      "why": "看客单价的月度变化，判断增长来自单价还是单量",
      "insight": "整体 497.11；完整月份中最高是 2011-01 的 620.15，最低是 2011-04 的 417.31。2011-12 显示 753.05 最高，但该月不完整且含随后被取消的大额订单。"
    },
    {
      "id": "customer_mix",
      "title": "每月 GMV 新老客拆分",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "customer_type",
        "label": "客群"
      },
      "width": "full",
      "section": "客群结构",
      "why": "看每月 GMV 中新客、老客和未识别客户各占多少，判断增长依赖哪类客群",
      "insight": "老客占全期 GMV 73.73%，新客 13.16%，未知（缺客户 ID）13.11%；单月最大一段是 2011-11 老客 1,064,539.67。2009-12 是数据起点，新客 462,001.42 高于老客的 215,914.65。"
    },
    {
      "id": "net_sales_monthly",
      "title": "每月净销售额（扣取消）",
      "type": "line",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "order_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "口径校正",
      "why": "看扣除取消后的真实成交额，识别被大额取消订单抬高的异常月份",
      "insight": "最高 2011-11 的 1,427,124.54，完整月份中最低 2011-04 的 482,061.93；2011-12 为 440,399.56，该月不完整，且计入的 GMV 中有后来被取消的订单金额。"
    }
  ],
  "filters": [
    {
      "column": "customer_type",
      "keep": [
        "新客",
        "老客",
        "未知"
      ],
      "label": "客群"
    },
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany",
        "France",
        "Netherlands"
      ],
      "other_label": "其他国家",
      "label": "国家"
    }
  ],
  "notes": [
    "口径：GMV 为下单口径（含之后被取消的订单）；净销售额 = GMV − 取消金额；取消单按取消发生的时间入账，不回溯原订单所在月份。",
    "不完整月份：2011-12 只到 12-09（数据截止），不能和完整月份比；2010-12-23 至 2011-01-03 停业，2010-12 与 2011-01 天数不足，2010-12 订单数比 2010-11 少 43%。",
    "极端大额订单：发票 541431、581483 等下单后很快全额取消，会抬高当月 GMV、客单价和商品排名，净销售额不受影响；2011-12 当月取消 174,091.36，占该月 GMV 的 28.3%。",
    "客户口径：全表约 22.24% 的行缺客户 ID，这部分金额计入 GMV，但不计入活跃客户数，在新老客拆分中归入「未知」；老客占全期 GMV 73.73%，客群结构以老客为主。",
    "新老客按周判定（客户首次购买的周）；2009-12 是数据起点，该月新客金额 462,001.42 高于老客 215,914.65，起点附近月份的新客占比偏高。",
    "单位为英镑（£）；客单价 = GMV ÷ 订单数，订单数只数销售订单（取消行没有订单号），两者可能不是同一批订单。"
  ]
}
