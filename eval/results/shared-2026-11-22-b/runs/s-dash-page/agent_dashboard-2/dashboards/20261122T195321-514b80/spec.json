{
  "title": "电商月度经营看板（2009-12 至 2011-12）",
  "goal": "给电商运营负责人一个可反复打开的月度经营看板：看清月度 GMV、净销售额、订单数、客单价与交易天数走势，判断月度波动来自单量还是客单价，并定位拉动增长的市场与新老客结构。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "sum",
      "column": "net_amount",
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "trading_days",
      "label": "交易天数",
      "agg": "count_distinct",
      "column": "order_date",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "全期 GMV（2009-12 至 2011-12）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出全期下单口径的商品交易总额，作为所有月度对比的基准",
      "insight": "覆盖期 2009-12 至 2011-12 的 GMV 合计 £19,643,861.64，为下单口径，含之后被取消的订单。"
    },
    {
      "id": "kpi_net",
      "title": "全期净销售额（扣取消）",
      "type": "kpi",
      "metrics": [
        "net_sales"
      ],
      "why": "给出扣除取消单后的实际成交总额，对照下单口径的 GMV",
      "insight": "扣除取消单后的全期净销售额 £18,927,399.07，是比下单口径更接近真实成交的规模。"
    },
    {
      "id": "month_gmv",
      "title": "每月 GMV（下单口径）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "月度规模",
      "why": "看每月 GMV 的走势与高点，定位增长或下滑发生在哪些月份",
      "insight": "2011-11 最高 £1,452,115.98，较 2011-10 的 £1,103,314.25 增长 31.61%；2011-12 只到 12-09（£614,490.92），不能与整月比。"
    },
    {
      "id": "month_net",
      "title": "每月净销售额（扣取消）",
      "type": "line",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "月度规模",
      "why": "对照 GMV 看每月真实成交额，识别被随后取消的大单抬高的月份",
      "insight": "2011-11 净销售额最高 £1,427,124.54，较 2011-10 的 £1,061,701.22 增长 34.42%；2011-12 仅 £440,399.56，同样是不完整月。"
    },
    {
      "id": "month_orders",
      "title": "每月订单数",
      "type": "column",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "width": "half",
      "section": "量价拆解",
      "why": "看每月订单笔数，配合客单价判断 GMV 变化来自单量还是单均金额",
      "insight": "2011-11 订单数最多 2,751 单，较 2011-10 的 2,005 单增长 37.21%；完整月中最低是 2010-01 的 1,049 单；2011-12 仅 816 单。"
    },
    {
      "id": "month_aov",
      "title": "每月客单价（含全期均值线）",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "reference": "overall",
      "width": "half",
      "section": "量价拆解",
      "why": "看每月单均金额，与订单数并排判断量价贡献，虚线为全期客单价均值",
      "insight": "全期客单价 £497.11；完整月最高 2011-01 的 £620.15、最低 2011-04 的 £417.31；2011-08 至 2011-11 均高于均值，2011-11 为 £527.85、较 2011-10 下降 4.08%；2011-12 的 £753.05 只覆盖部分日期。"
    },
    {
      "id": "month_days",
      "title": "每月交易天数（不完整月标记）",
      "type": "column",
      "metrics": [
        "trading_days"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "数据完整性",
      "why": "用每月有成交的天数标出数据不完整的月份，避免与整月直接比较",
      "insight": "多数月份为 26 个交易日；2011-12 只有 8 天（数据截止 12-09），2010-12 为 20 天、2011-01 为 24 天（2010-12-23 至 2011-01-03 停业），2009-12 为 21 天（数据起点），2011-04 为 21 天。"
    },
    {
      "id": "month_gmv_country",
      "title": "每月 GMV 按国家拆分",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "EIRE",
          "Germany"
        ],
        "other_label": "其他市场"
      },
      "width": "full",
      "section": "结构拆分",
      "why": "看每月 GMV 在主要市场间的构成变化，定位总量变化由哪个市场拉动",
      "insight": "英国占全期 GMV 的 85.53%，其他市场 9.35%、EIRE 3.17%、德国 1.95%；单月最高是 2011-11 的英国 £1,280,862.64。"
    },
    {
      "id": "month_gmv_cust",
      "title": "每月 GMV 按新老客拆分",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "customer_type"
      },
      "width": "full",
      "section": "结构拆分",
      "why": "看每月 GMV 在新客、老客与缺客户 ID 之间的构成变化，判断增长来自获客还是复购",
      "insight": "全期 GMV 中老客占 73.73%、新客 13.16%、缺客户 ID 的“未知”占 13.11%；新客 GMV 波动大（2010-03 £184,835.83、2010-08 £56,995.48、2010-10 £161,500.43）；单月最高为 2011-11 老客 £1,064,539.67。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany"
      ],
      "other_label": "其他市场",
      "label": "国家"
    }
  ],
  "year_filter": true,
  "notes": [
    "覆盖期：数据为 2009-12-01 至 2011-12-09（ISO 周 2009-W49 至 2011-W49），按月看共 25 个月份；2011-12 只到 12-09、仅 8 个交易日，不能与完整月直接比较。",
    "其他不完整月：2009-12（21 天，数据起点）、2010-12（20 天）与 2011-01（24 天，受 2010-12-23 至 2011-01-03 停业影响）、2011-04（21 天）；读图时先看交易天数图再比金额。",
    "GMV 为下单口径，含之后被取消的订单（如发票 541431、581483 这类大额订单会抬高当月 GMV 与商品排名）；取消单按取消发生时间入账、不回溯原订单月份，判断真实成交请看净销售额图。",
    "国家图中“其他市场”含法国、荷兰、西班牙等其余国家及“国家不明确”；英国占全期 GMV 的 85.53%，海外份额很小，需放大才能看清单市场的月度变化。",
    "客户类型中“未知”指缺客户 ID（约 22.2% 的行），其金额计入 GMV 但不参与新老客划分；新客按周判定，越靠近 2009-12 起点越可能把老客算成新客。",
    "订单数为去重的销售订单数（取消单不计入），客单价 = GMV ÷ 订单数；所有金额单位为英镑。"
  ]
}
