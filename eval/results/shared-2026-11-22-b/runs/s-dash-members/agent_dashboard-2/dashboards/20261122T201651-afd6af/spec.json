{
  "title": "2011年会员拉新与老客回购看板",
  "goal": "给会员运营负责人：判断 2011 年每月拉新人数与老客回购人数、GMV 的规模变化，以及新客主要来自哪些国家，从而决定拉新资源的投向。",
  "metrics": [
    {
      "id": "new_customers",
      "label": "新客数",
      "agg": "count_distinct",
      "column": "buyer_id",
      "where": {
        "customer_type": [
          "新客"
        ]
      }
    },
    {
      "id": "returning_customers",
      "label": "老客回购客户数",
      "agg": "count_distinct",
      "column": "buyer_id",
      "where": {
        "customer_type": [
          "老客"
        ]
      }
    },
    {
      "id": "new_customer_gmv",
      "label": "新客GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "where": {
        "customer_type": [
          "新客"
        ]
      },
      "format": "money"
    },
    {
      "id": "returning_customer_gmv",
      "label": "老客GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "where": {
        "customer_type": [
          "老客"
        ]
      },
      "format": "money"
    },
    {
      "id": "identified_customers",
      "label": "有客户ID的购买客户数",
      "agg": "count_distinct",
      "column": "buyer_id"
    },
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "new_customers_overseas",
      "label": "海外新客数",
      "agg": "count_distinct",
      "column": "buyer_id",
      "where": {
        "customer_type": [
          "新客"
        ],
        "country": [
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain",
          "Switzerland",
          "Belgium",
          "Portugal",
          "Australia",
          "Channel Islands",
          "Italy",
          "Sweden",
          "Norway",
          "Cyprus",
          "Finland",
          "Austria",
          "国家不明确",
          "Denmark",
          "Greece",
          "Japan",
          "USA",
          "Poland",
          "United Arab Emirates",
          "Israel",
          "Hong Kong",
          "Singapore",
          "Malta",
          "Canada",
          "Iceland",
          "RSA",
          "Bahrain",
          "Brazil",
          "Lebanon",
          "Czech Republic",
          "Saudi Arabia"
        ]
      }
    },
    {
      "id": "overseas_new_net_sales",
      "label": "海外新客净销售额",
      "agg": "sum",
      "column": "net_amount",
      "where": {
        "customer_type": [
          "新客"
        ],
        "country": [
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain",
          "Switzerland",
          "Belgium",
          "Portugal",
          "Australia",
          "Channel Islands",
          "Italy",
          "Sweden",
          "Norway",
          "Cyprus",
          "Finland",
          "Austria",
          "国家不明确",
          "Denmark",
          "Greece",
          "Japan",
          "USA",
          "Poland",
          "United Arab Emirates",
          "Israel",
          "Hong Kong",
          "Singapore",
          "Malta",
          "Canada",
          "Iceland",
          "RSA",
          "Bahrain",
          "Brazil",
          "Lebanon",
          "Czech Republic",
          "Saudi Arabia"
        ]
      },
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_new_cust",
      "title": "2011年新客数（全年去重）",
      "type": "kpi",
      "metrics": [
        "new_customers"
      ],
      "why": "全年一共拉了多少新客，是会员盘子的增量基数",
      "insight": "2011 年全年新客 1,537 人（按客户 ID 去重）。"
    },
    {
      "id": "kpi_ret_cust",
      "title": "2011年老客回购客户数（全年去重）",
      "type": "kpi",
      "metrics": [
        "returning_customers"
      ],
      "why": "全年有多少老客回来买过，看存量客户的回购规模",
      "insight": "2011 年全年有回购的老客 3,466 人（按客户 ID 去重）。"
    },
    {
      "id": "kpi_new_gmv",
      "title": "2011年新客GMV（下单口径）",
      "type": "kpi",
      "metrics": [
        "new_customer_gmv"
      ],
      "why": "新客在全年商品销售额里贡献了多少金额",
      "insight": "2011 年新客贡献 GMV £680,706.03（下单口径，含之后被取消的订单）。"
    },
    {
      "id": "kpi_ret_gmv",
      "title": "2011年老客GMV（下单口径）",
      "type": "kpi",
      "metrics": [
        "returning_customer_gmv"
      ],
      "why": "老客在全年商品销售额里贡献了多少金额",
      "insight": "2011 年老客贡献 GMV £7,491,322.05（下单口径）。"
    },
    {
      "id": "line_cust_month",
      "title": "每月新客数与老客回购客户数",
      "type": "line",
      "metrics": [
        "identified_customers"
      ],
      "x": {
        "column": "order_time",
        "grain": "month"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客"
        ]
      },
      "width": "full",
      "section": "拉新与回购",
      "why": "每月拉新人数和老客回购人数分别是多少、走势怎么变",
      "insight": "老客回购客户数 2011-11 最高为 1,492 人，新客数 2011-10 最高为 221 人；2011-12 两者分别为 585 和 30 人，数据只到 12-09。"
    },
    {
      "id": "stack_gmv_month",
      "title": "每月GMV构成：新客/老客/无客户ID",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "month"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "full",
      "section": "拉新与回购",
      "why": "每月 GMV 里新客和老客各贡献多少，旺季由谁撑起",
      "insight": "2011 年 GMV 合计 £9,471,580.96，老客占 79.1%、未知（缺客户 ID）占 13.7%、新客占 7.2%；老客单月最高为 2011-11 的 £1,064,539.67。"
    },
    {
      "id": "bar_country_new",
      "title": "2011年新客数 Top10国家",
      "type": "bar",
      "metrics": [
        "new_customers"
      ],
      "x": {
        "column": "country"
      },
      "top_n": 10,
      "highlight": [
        "United Kingdom",
        "France",
        "Germany"
      ],
      "width": "half",
      "section": "新客来源",
      "why": "2011 年新客按国家的规模排名，核心拉新来源国是谁",
      "insight": "英国新客 1,357 人居首，法国 46 人、德国 38 人、西班牙 14 人随后，其余国家新客人数都在个位数。"
    },
    {
      "id": "bar_overseas_new",
      "title": "2011年海外新客数 Top10国家",
      "type": "bar",
      "metrics": [
        "new_customers_overseas"
      ],
      "x": {
        "column": "country"
      },
      "top_n": 10,
      "highlight": [
        "France",
        "Germany",
        "Spain"
      ],
      "width": "half",
      "section": "新客来源",
      "why": "英国之外哪些国家带来了新客，海外拉新的抓手在哪",
      "insight": "海外新客法国 46 人最多，德国 38 人、西班牙 14 人、比利时 11 人随后，挪威与瑞士各 8 人。"
    },
    {
      "id": "bar_overseas_net",
      "title": "2011年海外新客净销售额 Top10国家",
      "type": "bar",
      "metrics": [
        "overseas_new_net_sales"
      ],
      "x": {
        "column": "country"
      },
      "top_n": 10,
      "highlight": [
        "Germany",
        "France",
        "Norway"
      ],
      "width": "full",
      "section": "新客来源",
      "why": "海外新客带来的真实成交金额排名，哪些国家值得投入",
      "insight": "海外新客净销售额合计 £112,868.09，德国 £28,405.32（25.2%）、法国 £22,359.96（19.8%）、挪威 £12,292.26（10.9%）居前。"
    }
  ],
  "period": {
    "start": "2011",
    "end": "2011"
  },
  "notes": [
    "全看板只统计 2011-01 至 2011-12。2011-01 数据从 01-04 开始（2010-12-23 至 2011-01-03 停业），2011-12 只到 12-09，两个月都不完整，不能与完整月直接比较。",
    "新客占比（按 2011 年全部新客 1,537 人计）：英国 1,357 人占 88.3%，法国 3.0%、德国 2.5%；英国以外 27 个国家合计 180 人、占 11.7%；新客数 Top10 之外的 18 个国家合计仅 37 人。",
    "新客/老客按首次购买所在周划分（customer_type=新客即该客户首次购买落在这一行所在的周），客户数均按客户 ID 去重；老客按月去重，同一客户会在多个月重复出现，月度相加会大于全年去重数 3,466；跨月的 ISO 周也会让个别新客在相邻两个月各计一次，月度新客之和略高于全年 1,537。",
    "约 22.2% 的行缺客户 ID（customer_type=未知，图中即“未知”段），这些行不计入任何客户数，但金额计入 GMV；客群折线图中“其他”段恒为 0，因为这些行没有客户 ID。",
    "GMV 为下单口径（含之后被取消的订单），取消金额按取消发生时间入账，少数大额全额取消订单会抬高对应月份的 GMV；海外新客金额排名改用净销售额（销售 − 取消）。",
    "口径说明：“老客回购客户数”“有客户 ID 的购买客户数”“海外新客数”“海外新客净销售额”为本看板按 customer_type / country 过滤自定义的口径；海外口径已排除英国，覆盖其余 35 个国家取值；国家类图表只显示前 10 名（新客数图共 28 个有拉新的国家，海外两图共 27 个国家）。"
  ]
}
