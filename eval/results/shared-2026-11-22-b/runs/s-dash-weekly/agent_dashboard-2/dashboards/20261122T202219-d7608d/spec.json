{
  "title": "运营周会看板：每周 GMV 与异常周",
  "goal": "给电商运营周会负责人：以 2009-W49 至 2011-W49 的周度数据判断最近完整周（2011-W48）表现是否异常、指标变化主要来自客流量、客单价还是取消，并圈出需人工复核的异常周。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "sum",
      "column": "net_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "GMV（2009-W49 起累计）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出全期 GMV 体量，作为周度波动的参照基准",
      "insight": "2009-W49 至 2011-W49 累计 GMV £19,643,861.64。"
    },
    {
      "id": "kpi_net",
      "title": "净销售额（2009-W49 起累计）",
      "type": "kpi",
      "metrics": [
        "net_sales"
      ],
      "why": "给出全期真实成交金额，对照 GMV 看取消掉了多少",
      "insight": "全期累计净销售额 £18,927,399.07。"
    },
    {
      "id": "kpi_aov",
      "title": "客单价（全期基准）",
      "type": "kpi",
      "metrics": [
        "aov"
      ],
      "why": "给出全期客单价基准，用于判断每周客单价是否偏离常态",
      "insight": "全期客单价 £497.11（GMV £19,643,861.64 ÷ 39,516 单）。"
    },
    {
      "id": "gmv_by_week",
      "title": "每周 GMV（ISO 周）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "full",
      "section": "每周走势",
      "why": "看每周 GMV 的走势与最近一周环比，判断最近一周是否偏离常态",
      "insight": "最近完整周 2011-W48 GMV £309,381.73，较 2011-W47 的 £302,392.22 升 2.31%；单周最高是 2011-W49 的 £483,725.13，但该周只到周五，不能与完整周直接比。"
    },
    {
      "id": "net_by_week",
      "title": "每周净销售额（ISO 周）",
      "type": "line",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "full",
      "section": "每周走势",
      "why": "看真实成交金额的周度走势，判断 GMV 变化里有多少被取消抵消",
      "insight": "最近完整周 2011-W48 净销售额 £306,115.06，较 2011-W47 的 £295,233.31 升 3.69%；净销售额最高的一周是 2011-W46 £369,129.47。"
    },
    {
      "id": "orders_by_week",
      "title": "每周订单数（ISO 周）",
      "type": "line",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "每周走势",
      "why": "看客流量（订单数）的周度走势，判断 GMV 变化是否来自单量",
      "insight": "最近完整周 2011-W48 订单数 663，较 2011-W47 的 616 升 7.63%；最低是 2009-W52 的 107 单。"
    },
    {
      "id": "aov_by_week",
      "title": "每周客单价（ISO 周）",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "reference": "overall",
      "width": "half",
      "section": "每周走势",
      "why": "看客单价的周度走势，判断 GMV 变化是否来自单笔金额",
      "insight": "最近完整周 2011-W48 客单价 £466.64，较 2011-W47 的 £490.90 降 4.94%，低于全期基准 £497.11；最高是 2011-W49 的 £950.34。"
    },
    {
      "id": "cancel_rate_by_week",
      "title": "每周取消率",
      "type": "line",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "reference": "overall",
      "width": "full",
      "section": "每周走势",
      "why": "看取消情况的周度变化，判断 GMV 与净销售额的差额来自哪一周",
      "insight": "最近完整周 2011-W48 取消率 1.06%，较 2011-W47 的 2.37% 下降 55.27%，低于全期 3.65%；最高的一周是 2011-W03 的 37.66%，需人工复核。"
    },
    {
      "id": "top_weeks_gmv",
      "title": "GMV 最高的 12 周",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "week"
      },
      "top_n": 12,
      "highlight": [
        "2011-W49",
        "2011-W48"
      ],
      "width": "full",
      "section": "异常复核",
      "why": "找出被极端大额订单抬高 GMV 的周，并看清最近完整周在历史高峰中的位置",
      "insight": "GMV 最高的一周是 2011-W49 £483,725.13，其中 £172,781.77 被取消（占 35.72%），且该周只到周五；最近完整周 2011-W48 £309,381.73 排第 9，其余 92 周合并为“其他”合计 £15,531,000.46（79.06%）。"
    }
  ],
  "year_filter": true,
  "notes": [
    "口径：GMV 为下单口径（gmv_amount 求和），含之后被取消的订单；净销售额 = GMV − 取消金额；取消单按取消发生的那一周入账，不回溯原订单周。",
    "2011-W49 只覆盖到 2011-12-09（周五），2009-W49 只覆盖数据起始日 2009-12-01 起的部分日期，这两周不能与完整周直接比较；最近完整周是 2011-W48。",
    "2010-12-23 至 2011-01-03 停业：2010-W52、2011-W01 只有部分天有数据，周度总量天然偏低，属需人工复核的异常周。",
    "少数大额订单（数据说明提到发票 541431、581483）下单后很快全额取消，会抬高当周 GMV 与排名，不影响净销售额；看真实成交请以净销售额为准。",
    "订单数与客单价按销售订单口径统计；约四分之一的行缺客户 ID，按客户口径统计时会漏掉，但这些行的金额仍计入 GMV。",
    "GMV 排名图只显示前 12 周，其余 92 周合并为“其他”，仅用于定位需要人工复核的峰值周。"
  ]
}
