{
  "title": "2011 年各国销售与取消看板",
  "goal": "给运营负责人看 2011 年各国家的销售与取消表现：判断市场规模最大的国家、取消率异常偏高且样本足够的市场，以及值得重点跟进的订单结构。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "sum",
      "column": "net_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "amount_sum",
      "label": "行金额",
      "agg": "sum",
      "column": "amount",
      "format": "money"
    }
  ],
  "charts": [
