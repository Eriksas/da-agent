{
  "title": "2011 年各国销售与取消看板",
  "goal": "给运营负责人看 2011 年各国家的销售与取消表现：按国家看 GMV/净销售额的走势与占比、取消金额与取消率、订单数与客单价，识别增长的市场和取消异常需要跟进的市场。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "sum",
      "column": "net_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "net_overseas",
      "label": "海外净销售额",
      "agg": "sum",
      "column": "net_amount",
      "where": {
        "country": [
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain",
          "Switzerland",
          "Belgium",
          "Portugal",
          "Australia",
          "Channel Islands",
          "Italy",
          "Sweden",
          "Norway",
          "Cyprus",
          "Finland",
          "Austria",
          "国家不明确",
          "Denmark",
          "Greece",
          "Japan",
          "USA",
          "Poland",
          "United Arab Emirates",
          "Israel",
          "Hong Kong",
          "Singapore",
          "Malta",
          "Canada",
          "Iceland",
          "RSA",
          "Bahrain",
          "Brazil",
          "Lebanon",
          "Saudi Arabia"
        ]
      },
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "2011 年 GMV",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给运营负责人一个 2011 年整体商品下单口径的规模基准",
      "insight": "2011 年 GMV 为 £9,471,580.96。"
    },
    {
      "id": "kpi_net",
      "title": "2011 年净销售额",
      "type": "kpi",
      "metrics": [
        "net_sales"
      ],
      "why": "看扣掉取消之后全年真正成交了多少钱",
      "insight": "2011 年净销售额 £9,013,227.66，是扣除取消金额后的真实成交额。"
    },
    {
      "id": "kpi_cancel",
      "title": "2011 年取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "给出全年取消金额占 GMV 的比重，作为各国取消率的比较基准",
      "insight": "2011 年取消率 4.84%（取消金额 £458,353.30 / GMV £9,471,580.96）。"
    },
    {
      "id": "kpi_orders",
      "title": "2011 年订单数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "看全年成交订单规模，作为各国订单量比较的基准",
      "insight": "2011 年成交订单 18,223 个（销售订单去重计数，取消单不计入）。"
    },
    {
      "id": "weekly_net",
      "title": "每周净销售额（2011）",
      "type": "line",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "order_date",
        "grain": "week",
        "label": "周"
      },
      "width": "full",
      "section": "总量与走势",
      "why": "看 2011 年每周真实成交（扣取消后）的节奏与旺季位置",
      "insight": "周度净销售额最高为 2011-W46 的 £369,129.47，最低为 2011-W17 的 £81,447.94；最后一个完整周 2011-W48 为 £306,115.06，较 2011-W47 的 £295,233.31 上升 3.69%。"
    },
    {
      "id": "month_gmv_mix",
      "title": "每月 GMV 按国家构成",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "EIRE",
          "Germany"
        ],
        "other_label": "其他国家",
        "label": "国家"
      },
      "width": "full",
      "section": "总量与走势",
      "why": "看每月 GMV 由哪些国家贡献、各国占比随时间怎么变",
      "insight": "2011 年英国占 GMV 84.67%，其他国家 10.55%、EIRE 2.76%、Germany 2.03%；单月最高是 2011-11 的英国 £1,280,862.64。"
    },
    {
      "id": "month_overseas_net",
      "title": "每月海外净销售额（按国家）",
      "type": "line",
      "metrics": [
        "net_overseas"
      ],
      "x": {
        "column": "order_date",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "country",
        "keep": [
          "EIRE",
          "Germany",
          "France",
          "Netherlands"
        ],
        "other_label": "其他海外市场",
        "label": "国家"
      },
      "width": "full",
      "section": "市场增长",
      "why": "看除英国外各市场扣除取消后的月度成交走势，判断哪些市场在增长",
      "insight": "德国净销售额从 2011-02 的 £8,249.24 升到 2011-08 的 £17,457.65；EIRE 从 2011-02 的 £9,464.14 升到 2011-07 的 £42,189.65；荷兰 2011-07 只有 £11.02（6 月 £26,738.09、8 月 £39,967.81）。"
    },
    {
      "id": "country_cancel_rate",
      "title": "各国取消率（2011）",
      "type": "bar",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "country",
        "label": "国家"
      },
      "reference": "overall",
      "highlight": [
        "USA",
        "Spain",
        "United Kingdom"
      ],
      "width": "half",
      "section": "取消与订单",
      "why": "看哪些国家取消金额占比明显高于整体，需要跟进",
      "insight": "取消率最高的是美国 51.66%（£1,849.47 / £3,580.39）与巴林 37.52%（£205.74 / £548.40）；西班牙 7.33%（£3,959.91 / £54,002.83）、英国 5.35%（£428,750.21 / £8,019,210.82），均高于整体 4.84%。"
    },
    {
      "id": "country_orders_aov",
      "title": "各国订单数与客单价",
      "type": "scatter",
      "metrics": [
        "orders",
        "aov"
      ],
      "x": {
        "column": "country",
        "label": "国家"
      },
      "reference": "overall",
      "highlight": [
        "United Kingdom",
        "Netherlands",
        "Australia"
      ],
      "width": "half",
      "section": "取消与订单",
      "why": "看各市场的订单规模与客单价关系，区分大单市场和下单量市场",
      "insight": "英国订单最多 16,461 单、客单价 £487.16，低于整体 £519.76；荷兰 90 单但客单价 £3,057.05、澳大利亚 53 单 £2,587.52（订单数很少）；比利时最低 £379.86（93 单）。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany",
        "France",
        "Netherlands"
      ],
      "other_label": "其他国家",
      "label": "国家"
    }
  ],
  "period": {
    "start": "2011-01-01",
    "end": "2011-12-09"
  },
  "notes": [
    "口径：GMV＝下单口径商品销售额，含之后被取消的订单；净销售额＝GMV−取消金额；取消单按取消发生时间入账，不回溯到原订单所在周。",
    "时间范围为 2011-01-04 至 2011-12-09（数据截止周五）；2010-12-23 至 2011-01-03 停业，故 2011-W01、2011-W49、2011-01、2011-12 都不是完整周期，不要与完整周/月直接比较。",
    "英国一家独大：2011 年英国占 GMV 84.67%，所以按国家看趋势时英国单列，另设「海外净销售额」＝除英国外 2011 年有交易的 35 个国家（含「国家不明确」）。",
    "少数大额订单（如发票 541431、581483）下单后很快全额取消，会抬高所在周/月的 GMV 与取消金额，净销售额不受影响。",
    "订单数＝销售订单去重计数（取消单不计入订单数），客单价＝GMV÷订单数，因此包含后来被取消的订单。",
    "约 22% 的行缺客户 ID（游客或未登记客户），其金额计入 GMV；本看板不使用按客户的指标。"
  ]
}
