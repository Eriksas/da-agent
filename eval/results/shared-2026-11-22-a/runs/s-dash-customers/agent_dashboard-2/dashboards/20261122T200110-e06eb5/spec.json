{
  "title": "新老客周度复盘 2009-W49~2011-W49",
  "goal": "给电商运营同学做每周新老客户复盘：判断每周增长来自拉新还是老客复购，新老客各贡献多少 GMV、订单数、客单价，并看清缺客户 ID 造成的口径缺口。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "active_customers",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "buyer_id"
    },
    {
      "id": "old_customers",
      "label": "老客数",
      "agg": "count_distinct",
      "column": "buyer_id",
      "where": {
        "customer_type": [
          "老客"
        ]
      }
    },
    {
      "id": "customers",
      "label": "客户数",
      "agg": "count_distinct",
      "column": "buyer_id"
    },
    {
      "id": "unknown_gmv",
      "label": "缺客户 ID 的 GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "where": {
        "customer_type": [
          "未知"
        ]
      },
      "format": "money"
    },
    {
      "id": "unknown_gmv_share",
      "label": "缺客户 ID GMV 占比",
      "agg": "ratio",
      "left": "unknown_gmv",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders_per_customer",
      "label": "人均订单数",
      "agg": "ratio",
      "left": "orders",
      "right": "active_customers"
    },
    {
      "id": "repeat_rate",
      "label": "复购客户占比",
      "agg": "ratio",
      "left": "old_customers",
      "right": "active_customers",
      "format": "percent"
    },
    {
      "id": "gmv_type",
      "label": "客群 GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "orders_type",
      "label": "客群订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov_type",
      "label": "客群客单价",
      "agg": "ratio",
      "left": "gmv_type",
      "right": "orders_type",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "k_gmv",
      "title": "2009-W49~2011-W49 全期 GMV",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出全期 GMV 总量，作为每周复盘的总盘参照。",
      "insight": "2009-W49 至 2011-W49 全期 GMV £19,643,861.64。"
    },
    {
      "id": "c_new_old_customers",
      "title": "每周新客数与老客数",
      "type": "line",
      "metrics": [
        "customers"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "half",
      "section": "客户规模",
      "why": "看新客与老客每周的规模变化，判断增长来自拉新还是老客活跃。",
      "insight": "2011-W48 老客数 483（2011-W47 为 455），新客数 31（2011-W47 为 37）；老客数最高 526 出现在 2011-W46；缺客户 ID 的行无法计客户数，未知组恒为 0。"
    },
    {
      "id": "c_active_customers",
      "title": "每周活跃客户数",
      "type": "line",
      "metrics": [
        "active_customers"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "客户规模",
      "why": "看每周活跃客户数总量与环比，确认客群规模的周度走势。",
      "insight": "2011-W48 活跃客户数 514，较 2011-W47 的 492 增 4.47%；全期最高 569 出现在 2011-W46。"
    },
    {
      "id": "c_gmv_mix",
      "title": "每周 GMV 构成（新客/老客/未知）",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "full",
      "section": "客群价值",
      "why": "看每周 GMV 由新客、老客、缺客户 ID 三部分各贡献多少。",
      "insight": "全期 GMV 中老客占 73.7%、新客占 13.2%、未知（缺客户 ID）占 13.1%；2011-W48 老客 £236,766.93、新客 £10,050.46、未知 £62,564.34。"
    },
    {
      "id": "c_unknown_share",
      "title": "每周缺客户 ID 的 GMV 占比",
      "type": "line",
      "metrics": [
        "unknown_gmv_share"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "客群价值",
      "why": "量化无法归入新老客的 GMV 规模，判断新老客口径的可信度。",
      "insight": "2011-W48 缺客户 ID 的 GMV 占 20.22%，2011-W47 为 19.37%；最高 46.85% 出现在 2010-W51。"
    },
    {
      "id": "c_orders_by_type",
      "title": "每周新老客订单数",
      "type": "line",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "half",
      "section": "客群价值",
      "why": "看新老客每周各贡献多少订单，判断订单量来自拉新还是老客。",
      "insight": "2011-W48 老客订单数 595（2011-W47 为 548），新客订单数 36（2011-W47 为 43）。"
    },
    {
      "id": "c_type_scatter",
      "title": "各客群 GMV 规模与客单价（全期）",
      "type": "scatter",
      "metrics": [
        "gmv_type",
        "aov_type"
      ],
      "x": {
        "column": "customer_type"
      },
      "reference": "overall",
      "highlight": [
        "老客",
        "未知"
      ],
      "width": "full",
      "section": "客群价值",
      "why": "全期口径对比各客群的金额规模与客单价，看谁量大、谁单价高。",
      "insight": "全期老客 GMV £14,482,828.22 规模最大，客单价 £478.55 低于缺客户 ID（未知）组的 £881.34；新客客单价最低 £408.49，整体参考值 £497.11。"
    },
    {
      "id": "c_orders_per_customer",
      "title": "每周人均订单数",
      "type": "line",
      "metrics": [
        "orders_per_customer"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "复购与频次",
      "why": "看每个活跃客户每周下几单，判断是首单为主还是复购为主。",
      "insight": "2011-W48 人均订单数 1.29（2011-W47 为 1.25），全期最低 1.15 出现在 2011-W33。"
    },
    {
      "id": "c_repeat_rate",
      "title": "每周复购客户占比（老客÷活跃客户）",
      "type": "line",
      "metrics": [
        "repeat_rate"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "复购与频次",
      "why": "看每周活跃客户里有多大比例是之前买过的老客，判断复购贡献。",
      "insight": "2011-W48 复购客户占比 93.97%（2011-W47 为 92.48%）；2009-W49 为 0，该周客户按首购计为新客。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom"
      ],
      "other_label": "海外",
      "label": "国家"
    }
  ],
  "year_filter": true,
  "period": {
    "start": "2009-11-30",
    "end": "2011-12-09"
  },
  "notes": [
    "口径：GMV 为下单口径（gmv_amount 之和，含之后被取消的订单）；订单数只数销售订单；活跃客户数不含缺客户 ID 的订单。",
    "新客/老客按客户首次购买的周划分，数据起点 2009-W49 的老客被算作新客，最初几周新客数偏高、老客数偏低；复购客户占比 = 老客数 ÷ 活跃客户数，老客含首购后隔多周再买。",
    "2011-W49 只到 2011-12-09（周五），不是完整周，不能与完整周直接比较；2011-W48 是最近一个完整周。",
    "2010-12-23 至 2011-01-03 停业，这几周没有数据，周序列上的空缺不是零。",
    "约 22.2% 的行缺客户 ID（未知）：其 GMV 计入总 GMV 但无法归入新老客，所以客户数类图里未知组恒为 0。",
    "少数金额极大、下单后很快全额取消的订单（如发票 541431、581483）会抬高对应周的 GMV 与占比，净销售额不受影响；周为 ISO 周。"
  ]
}
