{
  "title": "电商周度复盘看板（2009-W49~2011-W49）",
  "goal": "给电商运营负责人做每周复盘：看 2009-W49 至 2011-W49 的每周 GMV、订单数、客单价与新老客结构，判断新老客占比是否恶化、新客获取是否放缓。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "order_id"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "active_customers",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "buyer_id"
    },
    {
      "id": "new_customers",
      "label": "新客数",
      "agg": "count_distinct",
      "column": "buyer_id",
      "where": {
        "customer_type": [
          "新客"
        ]
      }
    },
    {
      "id": "new_customer_share",
      "label": "新客占比",
      "agg": "ratio",
      "left": "new_customers",
      "right": "active_customers",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "期间 GMV（下单口径）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "复盘期整体规模：这段时间一共做了多少生意",
      "insight": "期间 GMV 合计 £19,643,861.64（下单口径，含之后被取消的订单）。"
    },
    {
      "id": "kpi_orders",
      "title": "期间订单数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "复盘期整体规模：一共做了多少笔订单",
      "insight": "期间订单数 39,516 笔（不同发票号，只数销售订单）。"
    },
    {
      "id": "kpi_aov",
      "title": "期间客单价",
      "type": "kpi",
      "metrics": [
        "aov"
      ],
      "why": "复盘期整体规模：单均金额水平",
      "insight": "期间客单价 £497.11（GMV £19,643,861.64 ÷ 39,516 笔订单）。"
    },
    {
      "id": "weekly_orders",
      "title": "每周订单数",
      "type": "line",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "整体表现",
      "why": "看每周订单量的走势，以及最近一个完整周的环比增减",
      "insight": "最后一个完整周 2011-W48 订单 663 个，环比 2011-W47 的 616 个上升 7.6%；期间最高是 2011-W46 的 687 个，最低是 2009-W52 的 107 个。"
    },
    {
      "id": "weekly_aov",
      "title": "每周客单价",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "整体表现",
      "why": "看每周单均金额的走势，判断规模变化是来自单量还是客单价",
      "insight": "最后一个完整周 2011-W48 客单价 £466.64，环比 2011-W47 的 £490.90 下降 4.9%；期间最低是 2010-W06 的 £314.83，2011-W49 的 £950.34 只覆盖到 12 月 9 日，不能与完整周比。"
    },
    {
      "id": "gmv_by_seg",
      "title": "每周 GMV 新老客拆分",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "full",
      "section": "客群结构",
      "why": "看每周 GMV 总量（堆叠高度）以及新老客各贡献了多少",
      "insight": "期间 GMV 合计 £19,643,861.64：老客占 73.7%、新客占 13.2%、未知（缺客户 ID）占 13.1%；2009-W49 老客为 £0.00，是数据起点效应。"
    },
    {
      "id": "customers_by_seg",
      "title": "每周新客数与老客数",
      "type": "line",
      "metrics": [
        "active_customers"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "series": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客"
        ],
        "other_label": "未知（无客户ID）"
      },
      "width": "full",
      "section": "客群结构",
      "why": "看新客获取人数和老客留存人数的周度变化（两者相加即当周活跃客户数）",
      "insight": "新客数 2009-W49 为 425 人（数据起点），2010-W01 降到 67 人、2010-W09 为 116 人；老客数 2011-W46 达期间最高 526 人；缺客户 ID 的订单没有可识别客户，该序列恒为 0。"
    },
    {
      "id": "new_share",
      "title": "每周新客占比",
      "type": "line",
      "metrics": [
        "new_customer_share"
      ],
      "x": {
        "column": "order_time",
        "grain": "week"
      },
      "width": "half",
      "section": "客群结构",
      "why": "看新老客结构是否恶化、新客获取是否放缓",
      "insight": "新客占活跃客户的比重从 2010-W01 的 40.4%（67/166）降到 2010-W36 的 14.6%（38/260）；最后一个完整周 2011-W48 为 6.0%，环比 2011-W47 的 7.5% 下降 19.8%。"
    },
    {
      "id": "seg_table",
      "title": "新老客 GMV、订单数、客单价",
      "type": "table",
      "metrics": [
        "gmv",
        "orders",
        "aov"
      ],
      "x": {
        "column": "customer_type",
        "keep": [
          "新客",
          "老客",
          "未知"
        ]
      },
      "width": "full",
      "section": "客群结构",
      "why": "查新老客各自的 GMV、订单数和客单价明细",
      "insight": "期间老客 GMV £14,482,828.22、订单 30,264、客单价 £478.55；新客 GMV £2,585,754.52、订单 6,330、客单价 £408.49；未知（缺客户 ID）GMV £2,575,278.90、订单 2,922、客单价 £881.34。"
    }
  ],
  "filters": [
    {
      "column": "customer_type",
      "keep": [
        "新客",
        "老客",
        "未知"
      ],
      "label": "客群"
    }
  ],
  "year_filter": true,
  "period": {
    "start": "2009-12-01",
    "end": "2011-12-09"
  },
  "notes": [
    "口径：GMV 为下单口径（sum gmv_amount），含之后被取消的订单；取消单按取消发生的时间入账，不回溯原单所在周。少数金额极大且很快被全额取消的订单会抬高当周 GMV，净销售额不受影响。",
    "新客占比 = 新客数 ÷ 活跃客户数（活跃客户数不含缺客户 ID 的订单），是本次新增的口径；用顶部“客群”筛选后，该比例的分母随之变化。",
    "2009-W49（数据从 12 月 1 日开始）和 2011-W49（数据到 12 月 9 日）都不完整，不要与完整周直接比较。",
    "2010-12-23 至 2011-01-03 停业，2010-W52、2010-W53 及 2011-W01 头几天没有数据，这些周的总量偏低。",
    "约 22.2% 的行缺客户 ID（客群=未知）：金额计入 GMV，但不计入活跃客户数、新客数、老客数；新客按“该客户首次购买所在周”判定，数据起点附近的老客可能被算成新客。",
    "同比：顶部年份筛选在 2010 与 2011 之间切换、对照同一周；每张周度图给出的变化是最近一个完整周相对上一周的环比。"
  ]
}
