{
  "title": "商品看板：热卖与取消（运营）",
  "goal": "给电商运营负责人：判断 2011-W48 哪些商品卖得好（GMV、订单数、客单价，与 2011-W47 环比）、哪些商品取消得多（全期排行 + 周度趋势），并看清口径、小样本与极端大额订单的风险。",
  "metrics": [
    {
      "id": "gmv_w48",
      "label": "2011-W48 GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "where": {
        "week": [
          "2011-W48"
        ]
      },
      "format": "money"
    },
    {
      "id": "gmv_w47w48",
      "label": "W47+W48 GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "where": {
        "week": [
          "2011-W47",
          "2011-W48"
        ]
      },
      "format": "money"
    },
    {
      "id": "orders_w48",
      "label": "2011-W48 订单数",
      "agg": "count_distinct",
      "column": "order_id",
      "where": {
        "week": [
          "2011-W48"
        ]
      }
    },
    {
      "id": "aov_w48",
      "label": "2011-W48 客单价",
      "agg": "ratio",
      "left": "gmv_w48",
      "right": "orders_w48",
      "format": "money"
    },
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv_w48",
      "title": "2011-W48 GMV",
      "type": "kpi",
      "metrics": [
        "gmv_w48"
      ],
      "why": "给出 2011-W48 整周商品销售的基准金额",
      "insight": "2011-W48 整周 GMV £309,381.73（下单口径，含之后被取消的订单）。"
    },
    {
      "id": "top_gmv_w48",
      "title": "2011-W48 商品 GMV Top 10",
      "type": "bar",
      "metrics": [
        "gmv_w48"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 10,
      "highlight": [
        "23084",
        "22086"
      ],
      "width": "half",
      "section": "热卖商品",
      "why": "回答 2011-W48 哪些商品卖得最动，各自贡献了多少 GMV",
      "insight": "23084 以 £9,249.00 居首，占该周 GMV 的 2.99%，第二名 22086 £4,606.90（1.49%）；其余 2,293 个商品合计 £273,326.86，占 88.35%，商品集中度很低。"
    },
    {
      "id": "top_orders_w48",
      "title": "2011-W48 商品订单数 Top 10",
      "type": "bar",
      "metrics": [
        "orders_w48"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 10,
      "highlight": [
        "23084",
        "22086",
        "23493"
      ],
      "width": "half",
      "section": "热卖商品",
      "why": "回答 2011-W48 哪些商品被下单最多",
      "insight": "订单数最多的 23084 有 116 单，22086 有 101 单，第 10 名 23493 也有 53 单；该周有销量的商品共 2,303 个。"
    },
    {
      "id": "orders_aov_w48",
      "title": "2011-W48 订单数与客单价（头部商品）",
      "type": "scatter",
      "metrics": [
        "orders_w48",
        "aov_w48"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 15,
      "reference": "overall",
      "highlight": [
        "23084",
        "21790"
      ],
      "width": "full",
      "section": "热卖商品",
      "why": "把头部商品的订单规模与客单价放在一起，看谁量大、谁单价高",
      "insight": "订单数最多的 23084（116 单）客单价最高，为 £79.73；15 个头部商品客单价在 £11.41–£79.73 之间，均低于当周整体 £466.64（309,381.73 / 663）。"
    },
    {
      "id": "gmv_w47_w48_hm",
      "title": "头部商品 W47 与 W48 的 GMV",
      "type": "heatmap",
      "metrics": [
        "gmv_w47w48"
      ],
      "x": {
        "column": "week",
        "keep": [
          "2011-W47",
          "2011-W48"
        ],
        "label": "周"
      },
      "series": {
        "column": "stock_code",
        "keep": [
          "23084",
          "22423",
          "23582",
          "22086",
          "22197"
        ],
        "other_label": "其他商品",
        "label": "商品编码"
      },
      "width": "full",
      "section": "热卖商品",
      "why": "对比头部商品 2011-W47 与 2011-W48 的 GMV，看环比涨跌",
      "insight": "23084 的 GMV 从 2011-W47 的 £5,103.53 升到 2011-W48 的 £9,249.00，23582 从 £644.56 升到 £3,406.58；22086 由 £5,698.21 降到 £4,606.90，22423 由 £3,530.85 降到 £3,254.04。"
    },
    {
      "id": "top_cancel_amt",
      "title": "全期商品取消金额 Top 10",
      "type": "bar",
      "metrics": [
        "cancelled_amount"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 10,
      "highlight": [
        "23843",
        "23166"
      ],
      "width": "half",
      "section": "取消情况",
      "why": "回答全期（2009-W49 至 2011-W49）哪些商品被取消的金额最多",
      "insight": "23843 全期取消金额 £168,469.60，占全期取消金额 £716,462.57 的 23.51%；23166 £77,479.64（10.81%），第 3 名 22423 才 £16,545.30（2.31%），其余 4,899 个商品合计 £409,120.38（57.10%）。"
    },
    {
      "id": "top_cancel_rate",
      "title": "全期商品取消率 Top 10",
      "type": "bar",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 10,
      "reference": "overall",
      "highlight": [
        "PADS",
        "20715"
      ],
      "width": "half",
      "section": "取消情况",
      "why": "回答全期哪些商品取消率最高，并对照整体取消率水平",
      "insight": "取消率整体为 3.65%（716,462.57 / 19,643,861.637）；榜上 20715 为 100.0%（424.00 / 424.00），而排第一的 PADS 分母只有 0.017（取消金额 36.60），属小样本极端值。"
    },
    {
      "id": "weekly_gmv",
      "title": "全期周度 GMV",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "order_time",
        "grain": "week",
        "label": "周"
      },
      "width": "full",
      "section": "周度趋势",
      "why": "看 2009-W49 至 2011-W49 每周 GMV 的走势，以及最新完整周的水平",
      "insight": "最后一个完整周 2011-W48 的 GMV 为 £309,381.73，比 2011-W47 的 £302,392.22 上升 2.31%；2011-W49 只覆盖到 12 月 9 日，金额 £483,725.13 为全期最高，不能与完整周直接比。"
    },
    {
      "id": "weekly_cancel_rate",
      "title": "全期周度取消率",
      "type": "line",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "order_time",
        "grain": "week",
        "label": "周"
      },
      "reference": "overall",
      "width": "full",
      "section": "周度趋势",
      "why": "看全期每周取消率相对整体水平的走势，以及最新完整周的变化",
      "insight": "全期取消率整体 3.65%；最高是 2011-W03 的 37.66%，最低是 2011-W07 的 0.54%；2011-W48 为 1.06%，比 2011-W47 的 2.37% 下降 55.27%。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany",
        "France",
        "Netherlands"
      ],
      "other_label": "其他国家",
      "label": "国家"
    }
  ],
  "notes": [
    "口径：GMV＝sum(gmv_amount)，为下单口径，含之后被取消的订单；商品排行为下单口径，真实成交请看净销售额（net_amount＝GMV−取消金额）。取消单按取消发生时间入账，不回溯原订单所在周，因此取消率的分子分母不是同一批订单。",
    "商品指标 2011-W48 版（gmv_w48 / orders_w48 / aov_w48）与全期口径完全一致，只额外限定 2011-W48 这一完整周；订单数为不同发票号个数，只数销售订单。",
    "时间口径：ISO 周。2011-W48 是最后一个完整周；2011-W49 只到 12 月 9 日（约 5 天），2009-W49 同样只覆盖部分，两端不可与完整周直接比；2010-12-23 至 2011-01-03 停业，该段无数据。",
    "极端大额订单：23843 全期 GMV £168,469.60 中 100% 被取消、23166 有 94.8% 被取消，这类“下单后很快全部取消”的大单会抬高当周 GMV 与商品排名，净销售额不受影响；看商品排行时不要只看金额榜。",
    "小样本：按商品排名的取消率、客单价会被 1–2 单的小商品拉高（取消率榜第一的 PADS 分母只有 0.017），读排名务必同时看订单数与 GMV 体量。",
    "客户口径：22.24% 的行缺客户 ID（游客或未登记），按客户统计会偏少，但金额计入 GMV；本看板不按客户分组。商品以 stock_code 标识，名称见源表 description。"
  ]
}
