{
  "title": "2010 全年销售与对账看板",
  "goal": "给财务负责人看 2010 全年：①销售规模与逐月走势，②GMV 与净销售额的差额及取消异常周，③各国家/市场结构，④商品与客群结构，⑤需人工复核的极端大额订单与不完整周期。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV（下单口径）",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额（成交口径）",
      "agg": "difference",
      "left": "gmv",
      "right": "cancel_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders",
      "label": "销售订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "active_customers",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "customer_id",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "orders_per_cust",
      "label": "人均下单次数",
      "agg": "ratio",
      "left": "orders",
      "right": "active_customers"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "2010 全年 GMV（下单口径）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "全年销售规模有多大",
      "insight": "下单口径 GMV £9,374,379.51（含之后被取消的订单）。"
    },
    {
      "id": "kpi_net",
      "title": "2010 全年净销售额（成交口径）",
      "type": "kpi",
      "metrics": [
        "net_sales"
      ],
      "why": "真正落袋的销售额是多少",
      "insight": "净销售额 £9,135,828.32（GMV 扣除取消金额后的成交口径）。"
    },
    {
      "id": "kpi_orders",
      "title": "2010 全年销售订单数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "全年成交了多少订单、客单价水平",
      "insight": "销售订单 19,627 张，客单价口径见数据说明。"
    },
    {
      "id": "monthly_gmv",
      "title": "2010 每月 GMV",
      "type": "column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month"
      },
      "width": "full",
      "section": "整体与对账",
      "why": "全年逐月走势与季节性如何",
      "insight": "2010-11 最高 £1,429,700.78（占全年 15.3%），2010-02 最低 £537,909.68；11 月比 10 月高 30.6%；1 月、12 月只覆盖部分日期。"
    },
    {
      "id": "weekly_cancel_rate",
      "title": "2010 每周取消率",
      "type": "line",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "reference": "overall",
      "width": "full",
      "section": "整体与对账",
      "why": "GMV 与净销售额的差额多大、哪些周取消异常",
      "insight": "全年取消金额 £238,551.19、取消率 2.5%（238,551.19 / 9,374,379.51）；2010-W19 最高 13.5%（22,693.83 / 168,283.34），W26 6.9%、W39 6.3% 次之；W51 只到 12 月 23 日。"
    },
    {
      "id": "country_gmv",
      "title": "2010 各国家/市场 GMV",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain"
        ],
        "other_label": "其他市场"
      },
      "highlight": [
        "United Kingdom",
        "EIRE",
        "Netherlands"
      ],
      "width": "half",
      "section": "市场结构",
      "why": "销售集中在哪些市场、各占多少",
      "insight": "英国 £8,054,946.81 占 85.9%；EIRE £343,300.07、荷兰 £259,592.82、德国 £182,383.32 次之；西班牙 25.0% 的下单额后来被取消（8,991.93 / 36,009.74）。"
    },
    {
      "id": "top_products",
      "title": "2010 Top 10 商品净销售额",
      "type": "bar",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "description"
      },
      "top_n": 10,
      "highlight": [
        "REGENCY CAKESTAND 3 TIER",
        "WHITE HANGING HEART T-LIGHT HOLDER"
      ],
      "width": "full",
      "section": "商品与客群",
      "why": "哪些商品贡献最多、其余商品是长尾吗",
      "insight": "REGENCY CAKESTAND 3 TIER 净销售额 £176,307.69 最高，WHITE HANGING HEART T-LIGHT HOLDER £144,723.07 次之；其余 4,362 个商品合计 £8,440,978.78（92.4%），呈长尾。"
    },
    {
      "id": "monthly_repurchase",
      "title": "2010 每月人均下单次数（复购强度）",
      "type": "line",
      "metrics": [
        "orders_per_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month"
      },
      "reference": "overall",
      "width": "half",
      "section": "商品与客群",
      "why": "每月活跃客户规模与复购强度如何",
      "insight": "11 月活跃客户最多 1,606 位、下单 2,719 单，人均 1.69 单；全年 19,627 单对应 4,205 位去重客户（4.67 单/人），月度值低于全年值属去重口径差异。"
    },
    {
      "id": "big_orders",
      "title": "2010 极端大额订单 Top 10 发票",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice"
      },
      "top_n": 10,
      "highlight": [
        "533027"
      ],
      "width": "full",
      "section": "人工复核",
      "why": "哪些单据金额异常需要财务人工复核",
      "insight": "最大单笔 533027 号发票 £49,844.99，占全年 GMV 0.5%；其余 19,617 张订单合计 £9,070,957.20（96.8%）。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany",
        "France",
        "Netherlands",
        "Spain"
      ],
      "other_label": "其他市场",
      "label": "国家/市场"
    }
  ],
  "period": {
    "start": "2010",
    "end": "2010"
  },
  "notes": [
    "口径：GMV = line_type=销售 的 amount 合计（英镑，下单口径，含之后被取消的订单）；净销售额 = GMV − 取消金额；客单价 = GMV £9,374,379.51 ÷ 19,627 单 ≈ £477.63；取消记录的 invoice_time 是取消发生时间，可能与原销售不在同一周。",
    "时间边界：看板锁定 2010-01-01 至 2010-12-31，但表内 2010 年交易只覆盖 2010-01-04 至 2010-12-23（1 月 1–3 日、12 月 24–31 日无交易），故 2010-01、2010-12 与 2010-W51 为部分周期，不与完整周期直接比较。",
    "同比：数据起点为 2009-12-01，没有 2009 全年数据，各国家/市场的同比无法计算，需要补齐 2009 全年数据。",
    "新老客：2010 年的客户几乎都是数据内首次出现，且 22.2% 的销售行没有 customer_id（游客或未登记），活跃客户数偏低、新老客无法拆分，复购用人均下单次数近似。",
    "去重口径：活跃客户数按月去重，月度值不可相加；全年去重客户 4,205 位、全年人均 4.67 单，高于任何单月的 1.50–1.75 单是去重口径差异，不是复购变化。",
    "排名口径：国家 GMV 排名含后来被取消的金额（Top 商品图改用净销售额）；极端大额订单按下单金额排名，需人工核对其中的取消单据。"
  ]
}
