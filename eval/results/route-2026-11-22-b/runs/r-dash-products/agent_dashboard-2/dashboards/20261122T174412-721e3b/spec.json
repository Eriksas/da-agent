{
  "title": "商品表现与取消情况看板",
  "goal": "给老板看哪些商品卖得好、哪些商品取消得多：全期商品排行、头部商品周度走势、整体周节奏与最近完整周（2011-W48）表现，并区分下单口径与真实成交。",
  "metrics": [
    {
      "id": "gmv",
      "label": "销售GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_amt",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "difference",
      "left": "gmv",
      "right": "cancel_amt",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel_amt",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "gmv_head",
      "label": "头部商品周GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ],
        "stock_code": [
          "22423",
          "85123A",
          "85099B",
          "23843"
        ]
      },
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "全期销售GMV（未扣取消）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给老板一个全期生意规模的总数",
      "insight": "全期销售口径 GMV £19,643,861.64，取消另计。"
    },
    {
      "id": "kpi_rate",
      "title": "全期取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "给老板一个整体取消水平",
      "insight": "取消率 3.65%（£716,462.57 / £19,643,861.64）。"
    },
    {
      "id": "week_gmv",
      "title": "全市场周GMV趋势（最近完整周 2011-W48）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "full",
      "section": "整体节奏",
      "why": "看整体周度生意节奏，并锚定最近完整周的规模",
      "insight": "最近完整周销售 GMV £309,381.73，上一周 £302,392.22，环比 +2.3%；最高周 £483,725.13 属不完整周，不能直接比较。"
    },
    {
      "id": "gmv_top",
      "title": "商品GMV排行与集中度(前15)",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 15,
      "highlight": [
        "22423",
        "23843",
        "23166"
      ],
      "width": "full",
      "section": "卖得好的商品",
      "why": "看哪些商品卖得最多、金额多大，以及头部集中程度",
      "insight": "单品最高 22423 仅占 1.68%（£330,590.32）；其余 4880 个商品合计占 90.18%，集中度低；23843 的 £168,469.60 被 100% 取消、23166 被 94.8% 取消。"
    },
    {
      "id": "net_top",
      "title": "商品净销售额排行(前15)",
      "type": "bar",
      "metrics": [
        "net_sales"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 15,
      "highlight": [
        "22423",
        "85123A"
      ],
      "width": "full",
      "section": "卖得好的商品",
      "why": "看扣除取消后真正成交额最高的商品",
      "insight": "扣除取消后 22423 净销售额最高 £314,045.02、85123A £248,337.61、85099B £178,400.52；全期净销售额 £18,927,399.07。"
    },
    {
      "id": "top_trend",
      "title": "头部商品周GMV趋势(4款)",
      "type": "line",
      "metrics": [
        "gmv_head"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "series": {
        "column": "stock_code",
        "keep": [
          "22423",
          "85123A",
          "85099B",
          "23843"
        ]
      },
      "width": "full",
      "section": "卖得好的商品",
      "why": "看头部商品周度走势，以及异常大额单落在哪一周",
      "insight": "单笔最高出现在最后一个不完整周，是 23843 的 £168,469.60；最低为 85099B 的 £1.95。"
    },
    {
      "id": "cancel_top",
      "title": "商品取消金额排行(前15)",
      "type": "bar",
      "metrics": [
        "cancel_amt"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 15,
      "highlight": [
        "23843",
        "23166"
      ],
      "width": "half",
      "section": "取消多的商品",
      "why": "看哪些商品被取消的金额最多",
      "insight": "取消金额集中在 23843 £168,469.60（占 23.51%）与 23166 £77,479.64（10.81%）；其余 2871 个商品合计占 54.17%。"
    },
    {
      "id": "rate_top",
      "title": "商品取消率排行(前15)",
      "type": "bar",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "stock_code",
        "label": "商品编码"
      },
      "top_n": 15,
      "reference": "overall",
      "highlight": [
        "PADS",
        "20879"
      ],
      "width": "half",
      "section": "取消多的商品",
      "why": "看取消比例相对整体最高的商品，并识别小基数陷阱",
      "insight": "整体取消率 3.65%（£716,462.57 / £19,643,861.64）；榜首 PADS 达 215,294%（£36.60 / £0.017），销售基数极小；20879 为 297.4%（£201.60 / £67.80）。"
    },
    {
      "id": "cancel_trend",
      "title": "取消金额周趋势",
      "type": "line",
      "metrics": [
        "cancel_amt"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "full",
      "section": "取消多的商品",
      "why": "看取消金额的周度波动与最近完整周的回落",
      "insight": "最近完整周取消金额 £3,266.67，上一周 £7,158.91，环比 -54.4%；最高周 £172,781.77 属不完整周。"
    }
  ],
  "notes": [
    "口径：GMV=销售行的 amount 合计（按下单口径，含之后被取消的部分）；净销售额=销售−取消，看真实成交请用净销售额；取消率=取消金额÷销售金额。",
    "时间范围 2009-W49~2011-W49（周维度）。2009-W49、2011-W49 为不完整周（数据止于 2011-12-09），不能与完整周直接比较；2010-W52、2010-W53 无任何交易记录（圣诞停业），折线在这两周断开。",
    "极端大额单 581483（金额 £168,469.60）整笔落在商品 23843 上并被取消，占全部取消金额 23.51%，落在不完整的 2011-W49，会同时抬高该周的 GMV 与取消额。",
    "样本不足：取消率榜前列多为销售基数极小的商品（如 PADS 销售仅 £0.017），比率畸高但金额极小；判断取消规模请以「商品取消金额排行」为准。",
    "排名与集中度：图表工具每张排行最多显示前 15 名，其余合并为「其他」，无法单独呈现 Top20/Top50 口径；集中度看单品最高仅占 1.68%、其余 4880 个商品合计占 90.18%。",
    "商品以编码（stock_code）标识，与商品名称基本一一对应；金额单位为英镑。"
  ]
}
