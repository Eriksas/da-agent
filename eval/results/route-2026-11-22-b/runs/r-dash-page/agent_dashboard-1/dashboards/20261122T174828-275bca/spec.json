{
  "title": "电商月度经营看板（2009-2011）",
  "goal": "给电商运营同学看的月度经营看板：判断每月GMV升降主要来自订单规模还是客单价，定位需要复盘的月份，并看清客户结构与取消情况。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    },
    {
      "id": "customers",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "customer_id",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "sales_amt",
      "label": "销售金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_amt",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel_amt",
      "right": "sales_amt",
      "format": "percent"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "总GMV（销售口径）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "先看全期成交总额，作为所有月度数字的基准",
      "insight": "全期销售口径 GMV £19,643,861.64，其中包含 2011-12 这个不完整月。"
    },
    {
      "id": "kpi_orders",
      "title": "总订单数",
      "type": "kpi",
      "metrics": [
        "orders"
      ],
      "why": "看全期成交单量，判断GMV规模里订单规模的比重",
      "insight": "全期销售口径订单数 39,516 单，按发票号去重。"
    },
    {
      "id": "kpi_aov",
      "title": "客单价",
      "type": "kpi",
      "metrics": [
        "aov"
      ],
      "why": "看全期平均每单金额，作为月度客单价的参考线",
      "insight": "全期客单价 £497.11（GMV £19,643,861.637 ÷ 39,516 单）。"
    },
    {
      "id": "gmv_monthly",
      "title": "月度GMV（销售口径）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "full",
      "section": "整体规模",
      "why": "看每月成交金额走势，定位高峰月与低谷月",
      "insight": "2011-11 最高 £1,452,115.98，环比 2011-10 的 £1,103,314.25 增 31.6%；最低 2011-02 £507,799.87；2011-12 仅 £614,490.92（数据到 12-09），不可比。"
    },
    {
      "id": "aov_monthly",
      "title": "月度客单价（GMV÷订单数）",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "reference": "overall",
      "width": "half",
      "section": "增长驱动",
      "why": "看每单平均金额，判断GMV变化中客单价的贡献",
      "insight": "2011-12 为 £753.05 因不完整不可比；完整月份最高 2011-01 £620.15、最低 2011-04 £417.31，整体基准 £497.11；2011-11 £527.85 环比降 4.1%。"
    },
    {
      "id": "orders_monthly",
      "title": "月度订单数（去重发票号）",
      "type": "column",
      "metrics": [
        "orders"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "highlight": [
        "2011-11",
        "2011-02",
        "2011-12"
      ],
      "width": "half",
      "section": "增长驱动",
      "why": "看每月订单规模，判断GMV变化是否来自订单量",
      "insight": "2011-11 最高 2,751 单，环比 2011-10 的 2,005 单增 37.2%；完整月份订单数区间 1,049～2,751 单，2010-01 为 1,049 单；2011-12 仅 816 单，因不完整不可比。"
    },
    {
      "id": "customers_monthly",
      "title": "月度活跃客户数（去重客户号）",
      "type": "line",
      "metrics": [
        "customers"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "width": "half",
      "section": "增长驱动",
      "why": "看每月下单客户规模，判断增长来自更多客户还是更多复购",
      "insight": "2011-11 最高 1,660 人，环比 2011-10 的 1,361 人增 22.0%；完整月份区间 701～1,660 人，2010-01 为 701 人；2011-12 仅 614 人，因不完整不可比。"
    },
    {
      "id": "gmv_mix_a",
      "title": "月度GMV构成：头部客户 vs 其他客户",
      "type": "stacked_column",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "series": {
        "column": "customer_id",
        "keep": [
          "18102",
          "14646",
          "14156"
        ],
        "other_label": "其他客户（含未登记）",
        "label": "客户"
      },
      "width": "full",
      "section": "客群结构",
      "why": "看GMV由头部客户还是长尾与未登记客户贡献，替代无法直接切分的新老客",
      "insight": "头部客户 18102 占 2.96%、14646 占 2.68%、14156 占 1.54%，其余 92.82% 来自长尾客户与未登记游客；2011-11 峰值中其他客户贡献 £1,404,906.81。"
    },
    {
      "id": "cancel_rate_monthly",
      "title": "月度取消率（取消额÷销售额）",
      "type": "line",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month",
        "label": "月份"
      },
      "reference": "overall",
      "width": "half",
      "section": "客群结构",
      "why": "看每月取消金额占比，标出取消异常的月份",
      "insight": "整体取消率 3.65%；2011-12 为 28.33% 因不完整不可比，完整月份中 2011-01 达 13.65%（取消 £91,525.05）、2011-04 为 6.46%，均高于整体。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "EIRE",
        "Germany",
        "France",
        "Netherlands"
      ],
      "other_label": "其他海外",
      "label": "国家/地区"
    }
  ],
  "year_filter": true,
  "notes": [
    "口径：GMV=sum(amount) 且 line_type=销售；订单数=按发票号去重；客单价=GMV÷订单数；取消率=当月取消金额÷当月销售金额。金额单位为英镑(£)。",
    "2011-12 为不完整月份：数据只到 2011-12-09，该月 GMV £614,490.92、订单 816 单均不可与完整月直接比较；图上按不完整月标注。",
    "新老客无法直接切分：表内没有首单标记或注册时间，本看板用头部客户与长尾客户的月度GMV构成替代；22.2% 的交易行没有 customer_id（游客/未登记），已并入『其他客户（含未登记）』。",
    "取消单与原销售单不在同月发生，按月对齐的取消率反映当月发生的取消流水，不是当月订单的取消率；分类排名未使用净销售额，2011-12 的 28.33% 受不完整月影响。",
    "需复盘月份：2011-12（不完整月、取消率 28.33% 最高）、2011-11（GMV £1,452,115.98、订单 2,751 最高）、2011-04（客单价 £417.31 最低、取消率 6.46%）、2011-02（完整月 GMV 最低 £507,799.87）、2011-01（取消率 13.65%）、2010-05（取消率 5.78%）。",
    "数据背景：已删除重复、坏账调整、单价为 0 的记录，运费等非商品行不在表内；91.9% 的交易行来自英国，其余为海外。"
  ]
}
