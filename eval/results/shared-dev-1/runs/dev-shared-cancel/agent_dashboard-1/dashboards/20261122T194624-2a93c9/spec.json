{
  "title": "客服取消监控看板 2009-W49～2011-W48",
  "goal": "给客服主管：①按周判断取消金额和取消率集中在哪几周、要不要加派人手；②按国家定位取消最多的来源国，便于针对性跟进。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "gmv_amount",
      "format": "money"
    },
    {
      "id": "cancelled_amount",
      "label": "取消金额",
      "agg": "sum",
      "column": "cancelled_amount",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancelled_amount",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "cancel_invoices",
      "label": "取消单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "取消"
        ]
      }
    }
  ],
  "charts": [
    {
      "id": "kpi_cancel_amount",
      "title": "期间取消金额合计",
      "type": "kpi",
      "metrics": [
        "cancelled_amount"
      ],
      "why": "给客服主管一个要处理的取消总量级",
      "insight": "期间（2009-W49 至 2011-W48）取消金额合计 543,680.80 英镑。"
    },
    {
      "id": "kpi_cancel_rate",
      "title": "期间整体取消率",
