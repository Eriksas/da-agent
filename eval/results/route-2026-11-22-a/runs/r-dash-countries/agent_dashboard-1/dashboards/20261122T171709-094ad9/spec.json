{
  "title": "2011 年各国销售与取消看板",
  "goal": "给运营负责人看 2011 年各国家/地区的销售贡献与取消情况：判断主力市场是哪些、哪些市场在收缩，并锁定取消金额与取消率明显偏高、需要重点排查的国家。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV（销售口径）",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_amt",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "difference",
      "left": "gmv",
      "right": "cancel_amt",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel_amt",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "kpi_gmv",
      "title": "2011 全年 GMV（销售口径）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出 2011 年销售总量基准，后面所有国家对比都以此为分母",
      "insight": "2011 年销售口径 GMV 合计 £9,471,580.96，是全年销售规模基准。"
    },
    {
      "id": "kpi_cancel_rate",
      "title": "2011 全年取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "给出总体取消率基准，用于判断哪些国家偏高",
      "insight": "2011 年总体取消率 4.84%：取消金额 £458,353.30 ÷ GMV £9,471,580.96。"
    },
    {
