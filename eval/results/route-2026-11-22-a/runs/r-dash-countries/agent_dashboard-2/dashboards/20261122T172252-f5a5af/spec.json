{
  "title": "2011 各国销售与取消看板",
  "goal": "给运营负责人：判断各国市场规模大小、哪些市场取消率高需重点跟进，以及年内销售与取消的走势。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "cancel_amt",
      "label": "取消金额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "net_sales",
      "label": "净销售额",
      "agg": "difference",
      "left": "gmv",
      "right": "cancel_amt",
      "format": "money"
    },
    {
      "id": "cancel_rate",
      "label": "取消率",
      "agg": "ratio",
      "left": "cancel_amt",
      "right": "gmv",
      "format": "percent"
    },
    {
      "id": "amount_all",
      "label": "金额（销售+取消）",
      "agg": "sum",
      "column": "amount",
      "format": "money"
    },
    {
      "id": "gmv_ov",
      "label": "海外 GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "country": [
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain",
          "Switzerland",
          "Belgium",
          "Portugal",
          "Australia",
          "Channel Islands",
          "Italy",
          "Sweden",
          "Norway",
          "Cyprus",
          "Finland",
          "Austria",
          "Denmark",
          "Unspecified",
          "Greece",
          "Japan",
          "USA",
          "Poland",
          "United Arab Emirates",
          "Israel",
          "Hong Kong",
          "Singapore",
          "Malta",
          "Canada",
          "Iceland",
          "RSA",
          "Bahrain",
          "Brazil",
          "European Community",
          "Lebanon",
          "Czech Republic",
          "Saudi Arabia"
        ],
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "k_gmv",
      "title": "2011 GMV",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "看 2011 年整体成交规模（下单口径）",
      "insight": "2011 年 GMV £9,471,580.96（下单口径，含之后被取消的订单）。"
    },
    {
      "id": "k_net",
      "title": "2011 净销售额",
      "type": "kpi",
      "metrics": [
        "net_sales"
      ],
      "why": "看扣除取消后的真实成交规模",
      "insight": "2011 年净销售额 £9,013,227.66（销售减取消）。"
    },
    {
      "id": "k_cancel_amt",
      "title": "2011 取消金额",
      "type": "kpi",
      "metrics": [
        "cancel_amt"
      ],
      "why": "看全年被取消的绝对金额",
      "insight": "2011 年取消金额 £458,353.30，按 C 单开具时间计入当月、当国。"
    },
    {
      "id": "k_cancel_rate",
      "title": "2011 取消率",
      "type": "kpi",
      "metrics": [
        "cancel_rate"
      ],
      "why": "看整体取消水平，作为各国对比基准",
      "insight": "整体取消率 4.84%（458,353.30 / 9,471,580.96）。"
    },
    {
      "id": "c1",
      "title": "2011 各国 GMV 排名",
      "type": "bar",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "Netherlands",
          "EIRE",
          "Germany",
          "France",
          "Australia"
        ],
        "other_label": "其他 31 国",
        "label": "国家"
      },
      "highlight": [
        "United Kingdom"
      ],
      "section": "各国市场",
      "why": "看各国 GMV 规模排名与占比，判断哪些市场规模大",
      "insight": "英国 GMV £8,019,210.82，占 2011 年整体 £9,471,580.96 的 84.7%；海外前五依次为荷兰 2.9%、爱尔兰 2.8%、德国 2.0%、法国 1.9%、澳大利亚 1.5%。"
    },
    {
      "id": "c2",
      "title": "2011 海外市场 GMV 排名",
      "type": "bar",
      "metrics": [
        "gmv_ov"
      ],
      "x": {
        "column": "country",
        "keep": [
          "Netherlands",
          "EIRE",
          "Germany",
          "France",
          "Australia",
          "Unspecified"
        ],
        "other_label": "其他 30 国",
        "label": "国家"
      },
      "highlight": [
        "Netherlands"
      ],
      "width": "half",
      "section": "各国市场",
      "why": "剔除英国后单独看海外市场排名",
      "insight": "剔除英国后海外 2011 年 GMV 合计 £1,452,370.14：荷兰 £275,134.86（18.9%）、爱尔兰 18.0%、德国 13.2%、法国 12.1%、澳大利亚 9.4%；国家不明单列 £4,740.94（0.3%），其他 30 国 £406,088.18（28.0%）。"
    },
    {
      "id": "c3",
      "title": "2011 取消率最高的国家",
      "type": "bar",
      "metrics": [
        "cancel_rate"
      ],
      "x": {
        "column": "country",
        "label": "国家"
      },
      "top_n": 10,
      "reference": "overall",
      "highlight": [
        "Spain",
        "Japan",
        "United Kingdom",
        "USA"
      ],
      "width": "half",
      "section": "各国市场",
      "why": "找出取消率最高、需要重点跟进的市场",
      "insight": "整体取消率 4.84%（458,353.30 / 9,471,580.96）；美国 51.7%（1,849.47 / 3,580.39）最高但规模极小；在 GMV 1 万英镑以上的市场中，西班牙 7.3%（3,959.91 / 54,002.83）最高，日本 6.7%、英国 5.4% 也高于整体。"
    },
    {
      "id": "c4",
      "title": "各国 GMV 规模与取消率",
      "type": "scatter",
      "metrics": [
        "gmv",
        "cancel_rate"
      ],
      "x": {
        "column": "country",
        "label": "国家"
      },
      "top_n": 12,
      "reference": "overall",
      "highlight": [
        "Spain",
        "Netherlands",
        "United Kingdom"
      ],
      "section": "各国市场",
      "why": "同时看规模与取消率，定位规模大且取消率高的市场",
      "insight": "GMV 前 12 的国家中：英国规模最大 £8,019,210.82、取消率 5.35% 高于整体 4.84%；海外最大市场荷兰 £275,134.86、取消率仅 0.15% 最低；西班牙 £54,002.83 取消率 7.33% 最高。"
    },
    {
      "id": "c5",
      "title": "每月 GMV 与取消金额",
      "type": "line",
      "metrics": [
        "amount_all"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "month"
      },
      "series": {
        "column": "line_type"
      },
      "section": "月度走势",
      "why": "看年内销售与取消的月度走势",
      "insight": "销售最高为 2011-11 的 £1,452,115.98；取消金额最高为 2011-12 的 £174,091.36，但该月只到 12-09（不完整），次高 2011-01 £91,525.05（该月自 01-04 起）。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "Netherlands",
        "EIRE",
        "Germany",
        "France",
        "Australia"
      ],
      "label": "国家"
    }
  ],
  "period": {
    "start": "2011",
    "end": "2011"
  },
  "notes": [
    "口径：GMV = line_type「销售」的金额合计（含之后被取消的订单）；净销售额 = 销售 − 取消；取消率 = 取消金额 ÷ GMV；取消金额按 C 单开具时间计入当月、当国。",
    "数据仅到 2011-12-09：2011-12（W49 只到 12-09）与 2011-01（自 01-04 起）是不完整月份，不能与完整月份直接比较；取消单高度集中在 2011-01 与 2011-12 这两个月。",
    "英国占 2011 年 GMV 的 84.7%，已用 keep 单独分开，并另给一张只含海外市场的排名图；国家不明（Unspecified）在海外图中单独成组，£4,740.94（0.3%）。",
    "各国 GMV 排名是下单口径，可能被之后被取消的订单高估，看真实成交请用净销售额。",
    "取消率排名图只含 2011 年出现过取消的 27 个国家中的前 10 名；比率最高的国家基数很小（美国 GMV £3,580.39、巴林 £548.40），波动大；散点图只画了 GMV 最大的 12 个国家（共 37 个）。",
    "金额单位为英镑（£）；每行是订单中的一个商品行，不是订单数；本页未使用客户维度（customer_id 缺失 22.2%，为游客或未登记客户）。"
  ]
}
