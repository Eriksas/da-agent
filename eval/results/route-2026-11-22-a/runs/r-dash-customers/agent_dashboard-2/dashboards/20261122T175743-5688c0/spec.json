{
  "title": "2011 周度客户与商品复盘看板",
  "goal": "给电商运营同学做每周复盘：看 2011 年每周 GMV、活跃客户数、人均订单数与人均GMV 的走势与结构，并按国家、商品维度看复购/批量下单的分化，判断重点市场与主力商品。",
  "metrics": [
    {
      "id": "gmv_sales",
      "label": "GMV（销售口径）",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "gmv_cancel",
      "label": "取消额",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "取消"
        ]
      },
      "format": "money"
    },
    {
      "id": "gmv_net",
      "label": "净成交额",
      "agg": "difference",
      "left": "gmv_sales",
      "right": "gmv_cancel",
      "format": "money"
    },
    {
      "id": "active_cust",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "customer_id",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "orders_per_cust",
      "label": "人均订单数",
      "agg": "ratio",
      "left": "orders",
      "right": "active_cust"
    },
    {
      "id": "gmv_per_cust",
      "label": "人均GMV",
      "agg": "ratio",
      "left": "gmv_sales",
      "right": "active_cust",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "k_gmv",
      "title": "2011 年 GMV（销售口径）",
      "type": "kpi",
      "metrics": [
        "gmv_sales"
      ],
      "why": "先给全年总量，作为周度复盘的基数",
      "insight": "2011 年 GMV（销售口径）合计 £9,471,580.96，含无 customer_id 的游客订单金额。"
    },
    {
      "id": "k_cust",
      "title": "2011 年活跃客户数",
      "type": "kpi",
      "metrics": [
        "active_cust"
      ],
      "why": "看全年可识别客群的规模",
      "insight": "2011 年有 customer_id 的活跃客户 4,214 人（按客户去重），无 customer_id 的订单不计入任何客户数。"
    },
    {
      "id": "c_gmv_week",
      "title": "每周 GMV（销售口径）",
      "type": "line",
      "metrics": [
        "gmv_sales"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "full",
      "section": "周度复盘",
      "why": "看每周销售规模与节奏，判断哪几周异常",
      "insight": "完整周中 2011-W17 最低 £83,392.04；最近完整周 2011-W48 为 £309,381.73，比 2011-W47 的 £302,392.22 上升 2.31%；2011-W49 只到 12-09，不参与环比。"
    },
    {
      "id": "c_cust_week",
      "title": "每周活跃客户数",
      "type": "line",
      "metrics": [
        "active_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "full",
      "section": "周度复盘",
      "why": "看每周去重客户数，与 GMV 走势对照判断增长来自人还是客单价",
      "insight": "每周活跃客户数 2011-W17 最低 171 人，2011-W46 最高 569 人；最近完整周 2011-W48 为 514 人，比 2011-W47 的 492 人增加 4.47%。"
    },
    {
      "id": "c_ppo",
      "title": "每周人均订单数",
      "type": "line",
      "metrics": [
        "orders_per_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "half",
      "section": "周度复盘",
      "why": "人均订单数衡量一周内每位活跃客户的下单次数，是复购强度的代理指标",
      "insight": "人均订单数 2011-W19 最高 1.40 单（434 单 / 310 人），2011-W33 最低 1.15 单；最近完整周 2011-W48 为 1.29 单，比 2011-W47 的 1.25 单上升 3.03%。"
    },
    {
      "id": "c_pgc",
      "title": "每周人均 GMV",
      "type": "line",
      "metrics": [
        "gmv_per_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "half",
      "section": "周度复盘",
      "why": "与人均订单数对照，看客单价（人均GMV）与下单频次的此消彼长",
      "insight": "人均 GMV 2011-W14 最低 £465.09，2011-W38 达 £858.26；最近完整周 2011-W48 为 £601.91，比 2011-W47 的 £614.62 下降 2.07%。"
    },
    {
      "id": "c_stack_c",
      "title": "每周 GMV 结构（英国/德国/EIRE/其他）",
      "type": "stacked_column",
      "metrics": [
        "gmv_sales"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "series": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "Germany",
          "EIRE"
        ]
      },
      "width": "full",
      "section": "周度复盘",
      "why": "看每周 GMV 的市场结构，海外贡献是否集中在某些周",
      "insight": "2011 年 GMV 中英国占 84.67%，是最大来源；其他海外合计 10.55%，EIRE 2.76%、德国 2.03%。"
    },
    {
      "id": "c_country_ppo",
      "title": "各国人均订单数（对比整体）",
      "type": "bar",
      "metrics": [
        "orders_per_cust"
      ],
      "x": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "Germany",
          "EIRE",
          "France",
          "Netherlands",
          "Spain"
        ]
      },
      "reference": "overall",
      "highlight": [
        "Germany",
        "Spain",
        "EIRE"
      ],
      "width": "half",
      "section": "国家与商品",
      "why": "看各市场是批量大客还是零售小客，定位新老客分化最明显的国家",
      "insight": "客户数 84 人以上的市场中德国 4.45 单/人（93 人）最高，英国 4.32（3,808 人）与整体持平；西班牙 2.90、其他 2.86 偏低，EIRE 88.33（265 单 / 3 人）、荷兰 11.25（90 单 / 8 人）是批发大客的极端值。"
    },
    {
      "id": "c_prod",
      "title": "Top 10 商品净成交额",
      "type": "bar",
      "metrics": [
        "gmv_net"
      ],
      "x": {
        "column": "description"
      },
      "top_n": 10,
      "highlight": [
        "REGENCY CAKESTAND 3 TIER",
        "PARTY BUNTING"
      ],
      "width": "half",
      "section": "国家与商品",
      "why": "找出主力爆款（用净成交额抵消取消大单）",
      "insight": "净成交额最高的是 REGENCY CAKESTAND 3 TIER £137,737.33（占 1.53%），其次 PARTY BUNTING £97,036.14；其余 3901 个商品合计占 92.04%。"
    }
  ],
  "filters": [
    {
      "column": "country",
      "keep": [
        "United Kingdom",
        "Germany",
        "EIRE",
        "France",
        "Netherlands",
        "Spain"
      ],
      "label": "国家"
    }
  ],
  "period": {
    "start": "2011-01-03",
    "end": "2011-12-09"
  },
  "notes": [
    "本表没有 customer_type（新客/老客）字段，无法直接拆新客与老客；改用活跃客户数（去重 customer_id）与人均订单数（复购强度）作代理指标。",
    "缺 customer_id 的行占全表 22.2%（游客/未登记客户），不计入任何客户数，但金额仍计入 GMV，因此人均订单数与人均GMV 偏高；受字段限制无法把这部分金额单独拆出，按行数占比约为 GMV 的两成。",
    "GMV 为 line_type='销售' 的 amount 合计（£），是下单口径、未扣之后被取消的订单；商品排名改用净成交额（销售−取消）以抵消取消大单。",
    "周度主视图只含 2011：2011-W01 只有 1 月 4 日起的数据，2011-W49 只到 12-09，两周为不完整周，不与完整周做环比。",
    "订单数 = 去重发票号（销售行）；2011 全年整体人均订单数 4.32 单/人（18,223 单 / 4,214 人）。",
    "国家维度用 keep 合并长尾（英国、德国、EIRE、法国、荷兰、西班牙，其余合并为“其他”）；商品维度取前 10 名，其余 3901 个合并为“其他”。海外小市场多为 3–8 位批发大客，比率需谨慎解读。"
  ]
}
