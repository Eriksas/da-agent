{
  "title": "每周新老客复盘看板（近似口径）",
  "goal": "给电商运营做每周客群复盘：用活跃客户数、GMV、订单数、人均订单数与客单价的周度走势，判断增长来自客户规模扩张还是复购加深，并对比各国与头部商品的结构差异。最新完整周为 2011-W48，2011-W49 不完整、不参与环比。",
  "metrics": [
    {
      "id": "gmv",
      "label": "GMV",
      "agg": "sum",
      "column": "amount",
      "where": {
        "line_type": [
          "销售"
        ]
      },
      "format": "money"
    },
    {
      "id": "active_cust",
      "label": "活跃客户数",
      "agg": "count_distinct",
      "column": "customer_id",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "orders",
      "label": "订单数",
      "agg": "count_distinct",
      "column": "invoice",
      "where": {
        "line_type": [
          "销售"
        ]
      }
    },
    {
      "id": "orders_per_cust",
      "label": "人均订单数",
      "agg": "ratio",
      "left": "orders",
      "right": "active_cust"
    },
    {
      "id": "aov",
      "label": "客单价",
      "agg": "ratio",
      "left": "gmv",
      "right": "orders",
      "format": "money"
    }
  ],
  "charts": [
    {
      "id": "k_gmv",
      "title": "窗口累计 GMV（销售下单口径）",
      "type": "kpi",
      "metrics": [
        "gmv"
      ],
      "why": "给出复盘窗口的整体 GMV 规模，配合周趋势图定位最新完整周的位置",
      "insight": "窗口内销售口径 GMV 合计 4,922,458.03 英镑；为下单口径，未扣取消单，缺 customer_id 的订单也计入其中。"
    },
    {
      "id": "k_cust",
      "title": "窗口累计去重活跃客户数",
      "type": "kpi",
      "metrics": [
        "active_cust"
      ],
      "why": "看窗口内可触达的客户规模，作为新老客结构判断的分母",
      "insight": "窗口内按 customer_id 去重的活跃客户 3,182 人；缺 customer_id 的订单不计入客户数，这部分仍计入 GMV。"
    },
    {
      "id": "c_gmv_week",
      "title": "每周 GMV（销售下单口径）",
      "type": "line",
      "metrics": [
        "gmv"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "half",
      "section": "整体与客单价",
      "why": "看 GMV 的周度趋势与波动，定位最新完整周与高峰周",
      "insight": "2011-W48 GMV 309,381.73 英镑，环比 2011-W47 的 302,392.22 增长 2.3%；区间最低是 2011-W35 的 146,557.05；2011-W49 只统计到 12-09（483,725.13），不与完整周比较。"
    },
    {
      "id": "c_aov_week",
      "title": "每周客单价",
      "type": "line",
      "metrics": [
        "aov"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "reference": "overall",
      "width": "half",
      "section": "整体与客单价",
      "why": "看客单价的周度波动，判断金额变化主要来自单量还是单价",
      "insight": "2011-W48 客单价 466.6391 英镑（309,381.73 / 663），环比 2011-W47 的 490.8965 下降 4.9%，低于窗口整体 563.92 英镑（4,922,458.03 / 8,729）；2011-W49 的 950.3441 属不完整周，不参与比较。"
    },
    {
      "id": "c_active_week",
      "title": "每周活跃客户数（去重）",
      "type": "line",
      "metrics": [
        "active_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "width": "half",
      "section": "客群与复购",
      "why": "看活跃客户数的周度走势与波动，判断客户规模是在扩张还是收缩",
      "insight": "2011-W48 活跃客户数 514，环比 2011-W47 的 492 增长 4.5%；区间最高 2011-W46 的 569、最低 2011-W32 的 224；2011-W49 只到 12-09（415），不参与环比。"
    },
    {
      "id": "c_opc_week",
      "title": "每周人均订单数（复购强度）",
      "type": "line",
      "metrics": [
        "orders_per_cust"
      ],
      "x": {
        "column": "invoice_time",
        "grain": "week"
      },
      "reference": "overall",
      "width": "half",
      "section": "客群与复购",
      "why": "看人均下单次数的周度变化，判断复购深度是在加深还是变浅",
      "insight": "2011-W48 人均订单数 1.2899 单（663 单 / 514 客户）为区间最高，最低是 2011-W33 的 1.1455 单；窗口整体人均 2.7432 单（8,729 / 3,182），高于任何单周水平。"
    },
    {
      "id": "c_country",
      "title": "各国客户规模与人均订单数",
      "type": "scatter",
      "metrics": [
        "active_cust",
        "orders_per_cust"
      ],
      "x": {
        "column": "country",
        "keep": [
          "United Kingdom",
          "EIRE",
          "Germany",
          "France",
          "Netherlands",
          "Spain"
        ],
        "label": "国家"
      },
      "reference": "overall",
      "highlight": [
        "United Kingdom",
        "Germany",
        "Spain"
      ],
      "width": "full",
      "section": "国家与商品分化",
      "why": "看各国客户的规模与人均下单次数的组合，区分靠拉新还是靠复购的市场",
      "insight": "英国 2873 名客户是规模主体，人均订单数 2.7289 略低于整体 2.7432；德国 76 名客户人均 2.8289 高于整体；西班牙 22 名客户 1.8182 最低；EIRE 仅 2 名客户却达 69.0，荷兰 6 名客户 7.6667，样本过小不作结论。"
    },
    {
      "id": "c_product",
      "title": "头部商品规模与人均订单数",
      "type": "scatter",
      "metrics": [
        "gmv",
        "orders_per_cust"
      ],
      "x": {
        "column": "description",
        "label": "商品"
      },
      "top_n": 12,
      "reference": "overall",
      "highlight": [
        "PAPER CRAFT , LITTLE BIRDIE",
        "POPCORN HOLDER"
      ],
      "width": "full",
      "section": "国家与商品分化",
      "why": "看头部商品的金额规模与人均订单数，区分一次性大单商品和复购型商品",
      "insight": "图中仅含 GMV 最大的 12 个商品（共 3360 个）：PAPER CRAFT , LITTLE BIRDIE 金额 168,469.6 英镑、人均订单数 1.0 为最低（买家数与订单数相同）；POPCORN HOLDER 人均 2.4007 为最高，12 个商品都低于整体 2.7432。"
    }
  ],
  "filters": [
    {
      "column": "line_type",
      "order": [
        "销售",
        "取消"
      ],
      "label": "单据类型"
    }
  ],
  "period": {
    "start": "2011-08-01",
    "end": "2011-12-09"
  },
  "notes": [
    "口径：GMV、订单数、人均订单数均为 line_type=销售 的下单口径，未扣取消单；可在顶部“单据类型”筛选器中查看取消单。",
    "缺 customer_id 的订单（游客或未登记）计入 GMV，但不计入客户数与人均订单数，约占 GMV 的 13%，因此金额类与人数类指标的分母并不完全对齐。",
    "最新完整周为 2011-W48（GMV 309,381.73 英镑、活跃客户 514 人、人均订单数 1.2899 单）；2011-W49 只统计到 12-09，属不完整周，图中已标注，不与完整周做环比。",
    "新老客口径限制：表内没有“客户首单/首单周”字段，工具无法按首单周切出新客与老客；本看板以活跃客户数（规模侧）、人均订单数（复购侧）以及各国/各商品的人均订单数近似观察新老客结构。",
    "若后续补首单周字段再做新客数：越靠近数据起点越容易把老客误判为新客；本看板窗口为 2011-08-01 至 2011-12-09，已避开数据起点。",
    "商品散点只画了 GMV 最大的 12 个商品（共 3360 个）；国家散点中荷兰仅 6 名客户、EIRE 仅 2 名客户，其人均订单数为极小样本，不作结论。"
  ]
}
